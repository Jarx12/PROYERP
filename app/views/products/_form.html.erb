<%= form_with(model: product, local: true, html: { style: "line-height: 1.25; font-family: Arial, sans-serif;" }) do |form| %>
  
  <% if product.errors.any? %>
    <div style="background-color: #fff5f5; border: 1px solid #fed7d7; color: #c53030; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
      <h2 style="font-size: 16px; margin-top: 0; font-weight: bold;"><%= pluralize(product.errors.count, "error") %> impiden guardar este producto:</h2>
      <ul style="margin: 5px 0 0 0; padding-left: 20px; font-size: 14px;">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 20px;">
    <%= form.label :name, "Nombre del Producto / Herramienta", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 5px; font-size: 14px;" %>
    <%= form.text_field :name, placeholder: "Ej. Laptop HP ProBook, Taladro Percutor, etc.", style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748;" %>
  </div>

  <div style="margin-bottom: 20px;">
    <%= form.label :sku, "Código SKU (Único)", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 5px; font-size: 14px;" %>
    <%= form.text_field :sku, placeholder: "Ej. TEC-LAP-001, HER-TAL-042", style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748;" %>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 20px;">
    <div style="flex: 1;">
      <%= form.label :stock_current, "Stock Inicial", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 5px; font-size: 14px;" %>
      <%= form.number_field :stock_current, min: 0, disabled: product.persisted?, style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748; background-color: #{product.persisted? ? '#edf2f7' : 'white'};" %>
      <% if product.persisted? %>
        <span style="font-size: 11px; color: #718096; display: block; margin-top: 4px;">* Para alterar el stock use el registro de movimientos.</span>
      <% end %>
    </div>

    <div style="flex: 1;">
      <%= form.label :stock_minimum, "Stock Mínimo (Alerta)", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 5px; font-size: 14px;" %>
      <%= form.number_field :stock_minimum, min: 0, style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748;" %>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <%= form.label :description, "Descripción o Notas Adicionales", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 5px; font-size: 14px;" %>
    <%= form.text_area :description, rows: 4, placeholder: "Detalles adicionales, marca, número de serie o ubicación en almacén...", style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748; resize: vertical;" %>
  </div>

  <div style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e2e8f0; padding-top: 20px;">
    <%= link_to "Cancelar", products_path, style: "padding: 10px 18px; border: 1px solid #cbd5e0; border-radius: 6px; color: #4a5568; text-decoration: none; font-size: 14px; font-weight: bold; background-color: white;" %>
    <%= form.submit product.new_record? ? "Registrar Producto" : "Actualizar Producto", style: "padding: 10px 18px; border: none; border-radius: 6px; color: white; background-color: #38a169; font-size: 14px; font-weight: bold; cursor: pointer;" %>
  </div>

<% end %>
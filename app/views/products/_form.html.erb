<%= form_with(model: product) do |form| %>

  <% if product.errors.any? %>
    <div class="form-alert form-alert--danger">
      <h2 class="form-alert__title">
        <%= pluralize(product.errors.count, "error") %> impiden guardar este producto:
      </h2>
      <ul class="form-alert__list">
        <% product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Fila: Nombre + SKU -->
  <div class="form-row">
    <div class="form-col form-col--2">
      <%= form.label :name, "Nombre del Producto", class: "form-label form-label--required" %>
      <%= form.text_field :name,
            placeholder: "Ej. Tornillo de Acero Inoxidable 1/2",
            class: "form-input" %>
    </div>
    <div class="form-col form-col--1">
      <%= form.label :sku, "Código / SKU", class: "form-label form-label--required" %>
      <%= form.text_field :sku,
            placeholder: "Ej. TOR-001",
            class: "form-input" %>
    </div>
  </div>

  <!-- Fila: Categoría + Almacén -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :category_id, "Categoría", class: "form-label" %>
      <%= form.collection_select :category_id,
            Category.order(:name), :id, :name,
            { prompt: "— Seleccionar Categoría —" },
            class: "form-select" %>
    </div>
    <div class="form-col">
      <%= form.label :warehouse_id, "Almacén / Depósito", class: "form-label" %>
      <%= form.collection_select :warehouse_id,
            Warehouse.order(:name), :id, :name,
            { prompt: "— Seleccionar Almacén —" },
            class: "form-select" %>
    </div>
  </div>

  <!-- Fila: Ubicación + Peso -->
  <div class="form-row">
    <div class="form-col form-col--2">
      <%= form.label :location_detail, "Detalle de Ubicación Física", class: "form-label" %>
      <%= form.text_field :location_detail,
            placeholder: "Ej. Gabinete 15, Estante B, Repisa 3",
            class: "form-input" %>
    </div>
    <div class="form-col form-col--1">
      <%= form.label :weight, "Peso (Kg) (Opcional)", class: "form-label" %>
      <%= form.number_field :weight, step: "0.001",
            placeholder: "Ej. 0.250", class: "form-input" %>
    </div>
  </div>

  <!-- Bloque: Precios -->
  <div class="form-row form-section">
    <div class="form-col">
      <%= form.label :price_cost, "Precio de Costo ($)", class: "form-label" %>
      <%= form.number_field :price_cost, step: "0.01", min: 0,
            placeholder: "0.00", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :price_sale, "Precio de Venta ($)",
            class: "form-label form-label--accent" %>
      <%= form.number_field :price_sale, step: "0.01", min: 0,
            placeholder: "0.00", class: "form-input" %>
    </div>
  </div>

  <!-- Fila: Stock actual + Stock mínimo -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :stock_current, "Stock Inicial", class: "form-label" %>
      <%= form.number_field :stock_current,
            disabled: product.persisted?,
            class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :stock_minimum, "Stock Mínimo (Alerta)", class: "form-label" %>
      <%= form.number_field :stock_minimum, class: "form-input" %>
    </div>
  </div>

  <!-- Descripción -->
  <div class="form-row form-row--last">
    <div class="form-col">
      <%= form.label :description, "Descripción o Notas", class: "form-label" %>
      <%= form.text_area :description, rows: 3,
            placeholder: "Detalles técnicos, especificaciones, uso principal...",
            class: "form-input form-textarea" %>
    </div>
  </div>

  <!-- Acciones -->
  <div class="form-actions">
    <%= form.submit "Guardar Producto", class: "btn btn--success" %>
  </div>

<% end %>
<% content_for :title, "Editar Producto" %>

<%= render "layouts/form_page",
      title: "📝 Editar Producto",
      subtitle: "Actualice la información general o los parámetros de alerta de stock.",
      back: back_link_for(@product,
              labels: {
                record: "← Volver a la ficha del producto",
                index:  "← Volver al inventario"
              }) do %>

  <%= render "form", product: @product %>

<% end %>
<% content_for :title, "Editar Producto" %>

<div style="font-family: Arial, sans-serif; padding: 40px 20px; max-width: 650px; margin: 0 auto; line-height: 1.25;">
  
  <div style="margin-bottom: 15px;">
    <%= link_to "← Volver al inventario", products_path, style: "color: #718096; text-decoration: none; font-size: 14px;" %>
  </div>

  <div style="background-color: white; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05); padding: 30px;">
    
    <header style="margin-bottom: 25px; border-bottom: 1px solid #e2e8f0; padding-bottom: 15px;">
      <h1 style="color: #1a202c; font-size: 24px; margin: 0; font-weight: bold;">📝 Editar Producto</h1>
      <p style="color: #718096; margin: 6px 0 0 0; font-size: 14px;">Actualice la información general o los parámetros de alerta de stock.</p>
    </header>

    <%= render "form", product: @product %>

  </div>

  <div style="margin-top: 20px; text-align: center; font-size: 14px;">
    <%= link_to "👁️ Ver Ficha Técnica Actual", @product, style: "color: #38a169; text-decoration: none; font-weight: bold;" %>
  </div>

</div>
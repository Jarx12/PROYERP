<div id="<%= dom_id product %>">
  <p>
    <strong>Name:</strong>
    <%= product.name %>
  </p>

  <p>
    <strong>Sku:</strong>
    <%= product.sku %>
  </p>

  <p>
    <strong>Stock current:</strong>
    <%= product.stock_current %>
  </p>

  <p>
    <strong>Stock minimum:</strong>
    <%= product.stock_minimum %>
  </p>

</div>

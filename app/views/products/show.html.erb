<% content_for :title, "Producto: #{@product.name}" %>

<div class="page">

  <header class="page__header">
    <%= link_to "← Volver al inventario", products_path, class: "page__back" %>
    <div class="page__actions">
      <%= link_to "📝 Editar Producto", edit_product_path(@product), class: "btn btn--ghost" %>
    </div>
  </header>

  <!-- Hero: identidad + stock -->
  <div class="show-hero">
    <div class="show-hero__main">
      <div class="show-hero__tags">
        <span class="badge badge--muted">SKU: <%= @product.sku %></span>
        <% if @product.category.present? %>
          <span class="badge badge--blue">🏷️ <%= @product.category.name %></span>
        <% end %>
      </div>

      <h1 class="show-hero__title"><%= @product.name %></h1>
      <p class="show-hero__desc">
        <%= @product.description.presence || "Sin descripción detallada registrada." %>
      </p>
    </div>

    <div class="show-stock">
      <span class="show-stock__label">Stock Actual</span>
      <span class="show-stock__value <%= 'show-stock__value--low' if @product.stock_current <= @product.stock_minimum %>">
        <%= @product.stock_current %>
      </span>
      <span class="show-stock__hint">Mínimo requerido: <%= @product.stock_minimum %></span>
    </div>
  </div>

  <!-- Grid de metadatos -->
  <div class="show-grid">

    <div class="show-card">
      <h2 class="show-card__title">📍 Ubicación Logística</h2>
      <div class="show-card__field">
        <span class="show-card__label">Almacén / Depósito:</span>
        <span class="show-card__value">
          <%= @product.warehouse&.name || "Sin Almacén Asignado" %>
        </span>
      </div>
      <div class="show-card__field">
        <span class="show-card__label">Ubicación Específica:</span>
        <span class="show-card__value show-card__value--muted">
          <%= @product.location_detail.presence || "No especificada" %>
        </span>
      </div>
    </div>

    <div class="show-card">
      <h2 class="show-card__title">💰 Precios y Finanzas</h2>
      <div class="show-card__row">
        <div>
          <span class="show-card__label">Precio Costo:</span>
          <span class="show-card__value show-card__value--lg show-card__value--muted">
            $<%= number_with_precision(@product.price_cost || 0, precision: 2) %>
          </span>
        </div>
        <div>
          <span class="show-card__label">Precio Venta:</span>
          <span class="show-card__value show-card__value--lg show-card__value--accent">
            $<%= number_with_precision(@product.price_sale || 0, precision: 2) %>
          </span>
        </div>
      </div>
    </div>

    <div class="show-card">
      <h2 class="show-card__title">⚖️ Especificaciones</h2>
      <div class="show-card__field">
        <span class="show-card__label">Peso Unitario:</span>
        <span class="show-card__value show-card__value--lg">
          <%= @product.weight.present? ? "#{@product.weight} kg" : "No registrado" %>
        </span>
      </div>
    </div>

  </div>

  <!-- Historial de movimientos -->
  <div class="show-history">
    <div class="show-history__header">
      <div>
        <h2 class="show-history__title">📋 Historial de Movimientos</h2>
        <span class="show-history__count"><%= @stock_movements.count %> registros</span>
      </div>

      <div class="show-history__actions">
        <%= link_to "🟢 Subir Stock", new_movement_product_path(@product, type: "input"), class: "btn btn--success" %>
        <%= link_to "🔴 Bajar Stock", new_movement_product_path(@product, type: "output"), class: "btn btn--danger" %>
      </div>
    </div>

    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fecha / Hora</th>
            <th class="data-table__th--center">Tipo</th>
            <th class="data-table__th--center">Cantidad</th>
            <th>Motivo / Referencia</th>
          </tr>
        </thead>
        <tbody>
          <% if @stock_movements.any? %>
            <% @stock_movements.each do |movement| %>
              <% is_input = movement.movement_type == "input" %>
              <tr>
                <td class="data-table__td--muted">
                  <%= movement.created_at.strftime("%d/%m/%Y %H:%M") %>
                </td>
                <td class="data-table__td--center">
                  <% if is_input %>
                    <span class="badge badge--success">Entrada</span>
                  <% else %>
                    <span class="badge badge--danger">Salida</span>
                  <% end %>
                </td>
                <td class="data-table__td--center <%= is_input ? 'text-success' : 'text-danger' %>">
                  <strong><%= is_input ? "+#{movement.quantity}" : "-#{movement.quantity}" %></strong>
                </td>
                <td class="data-table__td--muted">
                  <%= movement.reason %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="data-table__empty">
                No se han registrado movimientos para este producto aún.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>
<% content_for :title, "Ajuste de Inventario" %>

<% back = back_link_for(@product) %>

<div class="page page--narrow">

  <%= link_to back[:label], back[:path], class: "page__back" %>

  <div class="table-card" style="padding: 30px;">

    <header class="form-header">
      <h1 class="form-header__title">📊 Registrar Movimiento de Stock</h1>
      <p class="form-header__subtitle">
        Producto: <strong><%= @product.name %></strong>
        (Stock Actual: <strong class="text-primary"><%= @product.stock_current %></strong>)
      </p>
    </header>

    <%= form_with(model: @stock_movement, url: create_movement_product_path(@product), method: :post) do |form| %>

      <% if @stock_movement.errors.any? %>
        <div class="form-alert form-alert--danger">
          <h2 class="form-alert__title">
            <%= pluralize(@stock_movement.errors.count, "error") %> impiden procesar este movimiento:
          </h2>
          <ul class="form-alert__list">
            <% @stock_movement.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Tipo de Operación -->
      <div class="form-group">
        <%= form.label :movement_type, "Acción a realizar", class: "form-label" %>
        <%= form.select :movement_type,
              [["🟢 Subir Stock (Entrada / Compra)", "input"],
               ["🔴 Bajar Stock (Salida / Entrega / Retiro)", "output"]],
              {},
              class: "form-select" %>
      </div>

      <!-- Cantidad -->
      <div class="form-group">
        <%= form.label :quantity, "Cantidad de unidades", class: "form-label" %>
        <%= form.number_field :quantity, min: 1, placeholder: "Ej. 5", class: "form-input" %>
      </div>

      <!-- Motivo -->
      <div class="form-group form-group--lg">
        <%= form.label :reason, "Motivo o Observación", class: "form-label" %>
        <%= form.text_field :reason,
              placeholder: "Ej. Recepción de lote, Asignación a proyecto, Merma, etc.",
              class: "form-input" %>
      </div>

      <!-- Botones -->
      <div class="form-actions">
        <%= link_to "Cancelar", product_path(@product), class: "btn btn--ghost" %>
        <%= form.submit "Aplicar Cambios", class: "btn btn--success" %>
      </div>

    <% end %>

  </div>
</div>
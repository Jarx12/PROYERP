<% content_for :title, "Inventario de Productos" %>

<div class="page">

  <header class="page__header">
    <div>
      <h1 class="page__title">📦 Inventario de Productos</h1>
      <p class="page__subtitle">Control de existencias, catálogo y trazabilidad de movimientos.</p>
    </div>
    <div class="page__actions">
      <%= link_to "+ Nuevo Producto", new_product_path, class: "btn btn--success" %>
    </div>
  </header>

  <!-- Métricas rápidas -->
  <div class="stats-bar">
    <div class="stat">
      <span class="stat__label">Total Ítems</span>
      <p class="stat__value"><%= @products.count %></p>
    </div>
    <div class="stat stat--warning">
      <span class="stat__label">Stock Bajo / Mínimo</span>
      <p class="stat__value"><%= @low_stock_count %></p>
    </div>
    <div class="stat stat--danger">
      <span class="stat__label">Agotados (Sin Stock)</span>
      <p class="stat__value"><%= @out_of_stock_count %></p>
    </div>
  </div>

  <!-- Tabla -->
  <div class="table-card">
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>SKU</th>
            <th>Producto</th>
            <th class="data-table__th--center">Stock Mín.</th>
            <th class="data-table__th--center">Stock Actual</th>
            <th class="data-table__th--center">Estado</th>
            <th class="data-table__th--right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if @products.any? %>
            <% @products.each do |product| %>
              <tr>
                <td class="data-table__td--code"><%= product.sku %></td>

                <td>
                  <%= link_to product.name, product, class: "data-table__product-link" %>
                  <span class="data-table__meta">
                    <%= truncate(product.description, length: 50) %>
                  </span>
                </td>

                <td class="data-table__td--center data-table__td--muted">
                  <%= product.stock_minimum %>
                </td>

                <td class="data-table__td--center data-table__td--strong">
                  <%= product.stock_current %>
                </td>

                <td class="data-table__td--center">
                  <% if product.stock_current == 0 %>
                    <span class="badge badge--danger">Sin Stock</span>
                  <% elsif product.stock_current <= product.stock_minimum %>
                    <span class="badge badge--warning">Bajo Stock</span>
                  <% else %>
                    <span class="badge badge--success">Normal</span>
                  <% end %>
                </td>

                <td class="data-table__td--right">
                  <div class="data-table__actions">
                    <%= link_to "Ver Detalles", product,
                          class: "btn btn--subtle btn--sm" %>
                    <%= link_to "Mov. Stock", new_movement_product_path(product),
                          class: "btn btn--subtle btn--sm" %>
                    <%= link_to "✏️", edit_product_path(product),
                          title: "Editar",
                          class: "action-link action-link--edit" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="data-table__empty">
                No hay productos registrados en el inventario.
                <%= link_to "Registrar el primero", new_product_path, class: "link-inline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= link_to "← Volver al Dashboard", root_path, class: "page__back" %>
</div>
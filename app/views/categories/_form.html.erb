<%= form_with(model: category, local: true) do |form| %>

  <% if category.errors.any? %>
    <div style="background-color: #fff5f5; border: 1px solid #fed7d7; color: #c53030; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
      <h2 style="font-size: 14px; margin: 0 0 5px 0; font-weight: bold;">
        <%= pluralize(category.errors.count, "error") %> impiden guardar esta categoría:
      </h2>
      <ul style="margin: 0; padding-left: 20px; font-size: 13px;">
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 20px;">
    <%= form.label :name, "Nombre de la Categoría *", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 6px; font-size: 13px;" %>
    <%= form.text_field :name, placeholder: "Ej. Herramientas, Tornillos, Electrónicos...", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748;" %>
  </div>

  <div style="margin-bottom: 25px;">
    <%= form.label :description, "Descripción u Observaciones (Opcional)", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 6px; font-size: 13px;" %>
    <%= form.text_area :description, rows: 3, placeholder: "Breve descripción sobre el tipo de insumos o productos que abarca...", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748;" %>
  </div>

  <div style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e2e8f0; padding-top: 20px;">
    <%= link_to "Cancelar", settings_path, style: "padding: 10px 18px; border: 1px solid #cbd5e0; border-radius: 6px; color: #4a5568; text-decoration: none; font-size: 14px; font-weight: bold; background-color: white;" %>
    <%= form.submit "Guardar Categoría", style: "padding: 10px 20px; border: none; border-radius: 6px; color: white; background-color: #3182ce; font-size: 14px; font-weight: bold; cursor: pointer;" %>
  </div>

<% end %>
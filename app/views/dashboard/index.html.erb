<% content_for :title, "Dashboard - ProyERP" %>

<div class="page page--wide">

  <header class="page__header page__header--bordered">
    <div>
      <h1 class="page__title">📊 Panel de Control</h1>
      <p class="page__subtitle">Bienvenido al sistema de gestión ProyERP.</p>
    </div>
    <div class="dashboard__env-badge">
      <span class="dashboard__env-dot"></span>
      PROYERECA
    </div>
  </header>

  <div class="dashboard__grid">

    <!-- Personal y Nómina -->
    <div class="dashboard-card dashboard-card--blue">
      <div>
        <div class="dashboard-card__header">
          <h2 class="dashboard-card__title">👨‍💼 Personal y Nómina</h2>
          <span class="dashboard-card__badge dashboard-card__badge--blue">Recursos Humanos</span>
        </div>
        <p class="dashboard-card__value"><%= @total_employees %></p>
        <p class="dashboard-card__caption">Empleados registrados activos.</p>
      </div>
      <%= link_to employees_path, class: "dashboard-card__link dashboard-card__link--blue" do %>
        Gestionar Empleados <span>→</span>
      <% end %>
    </div>

    <!-- Cuentas y Finanzas -->
    <div class="dashboard-card dashboard-card--teal">
      <div>
        <div class="dashboard-card__header">
          <h2 class="dashboard-card__title">💰 Cuentas y Finanzas</h2>
          <span class="dashboard-card__badge dashboard-card__badge--teal">
            <%= @bank_accounts.count %> Cuentas
          </span>
        </div>
        <div class="dashboard-card__balances">
          <div class="dashboard-card__balance">
            <span class="dashboard-card__balance-label">VES</span>
            <strong class="dashboard-card__balance-value">
              Bs. <%= number_to_currency(@total_ves_balance, unit: '', delimiter: '.', separator: ',') %>
            </strong>
          </div>
          <div class="dashboard-card__balance">
            <span class="dashboard-card__balance-label">USD</span>
            <strong class="dashboard-card__balance-value dashboard-card__balance-value--usd">
              $<%= number_to_currency(@total_usd_balance, unit: '', delimiter: ',', separator: '.') %>
            </strong>
          </div>
        </div>
      </div>
      <%= link_to financial_transactions_path, class: "dashboard-card__link dashboard-card__link--teal" do %>
        Ver Transacciones <span>→</span>
      <% end %>
    </div>

    <!-- Inventario -->
    <div class="dashboard-card dashboard-card--green">
      <div>
        <div class="dashboard-card__header">
          <h2 class="dashboard-card__title">📦 Inventario</h2>
          <span class="dashboard-card__badge dashboard-card__badge--green">Stock Central</span>
        </div>
        <p class="dashboard-card__value"><%= @total_products %></p>
        <p class="dashboard-card__caption">Productos y existencias registradas.</p>
      </div>
      <%= link_to products_path, class: "dashboard-card__link dashboard-card__link--green" do %>
        Gestionar Inventario <span>→</span>
      <% end %>
    </div>

    <!-- Flota Vehicular -->
    <div class="dashboard-card dashboard-card--purple">
      <div>
        <div class="dashboard-card__header">
          <h2 class="dashboard-card__title">🚗 Flota Vehicular</h2>
          <span class="dashboard-card__badge dashboard-card__badge--purple">Transporte</span>
        </div>
        <p class="dashboard-card__value"><%= @total_vehicles %></p>
        <p class="dashboard-card__caption">Unidades activas, asignaciones y documentos.</p>
      </div>
      <%= link_to vehicles_path, class: "dashboard-card__link dashboard-card__link--purple" do %>
        Gestionar Vehículos <span>→</span>
      <% end %>
    </div>

    <!-- Documentación -->
    <div class="dashboard-card dashboard-card--orange">
      <div>
        <div class="dashboard-card__header">
          <h2 class="dashboard-card__title">📄 Documentación</h2>
          <span class="dashboard-card__badge dashboard-card__badge--orange">Archivos</span>
        </div>
        <p class="dashboard-card__value"><%= @total_documents %></p>
        <p class="dashboard-card__caption">Archivos y anexos resguardados en el ERP.</p>
      </div>
      <%= link_to documents_path, class: "dashboard-card__link dashboard-card__link--orange" do %>
        Ver Documentos <span>→</span>
      <% end %>
    </div>

  </div>
</div>
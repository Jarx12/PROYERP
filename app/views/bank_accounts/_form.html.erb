<%= form_with(model: bank_account) do |form| %>

  <% if bank_account.errors.any? %>
    <div class="form-alert form-alert--danger">
      <h2 class="form-alert__title">
        <%= pluralize(bank_account.errors.count, "error") %> impiden guardar esta cuenta:
      </h2>
      <ul class="form-alert__list">
        <% bank_account.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Institución -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :institution, "Institución Bancaria",
            class: "form-label form-label--required" %>
      <%= form.text_field :institution,
            placeholder: "Ej. Banco Banesco / Zelle / Cash",
            class: "form-input" %>
    </div>
  </div>

  <!-- Moneda -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :currency, "Moneda",
            class: "form-label form-label--required" %>
      <%= form.select :currency,
            [["Bolívares (VES)", "VES"], ["Dólares (USD)", "USD"]],
            { prompt: "Seleccione moneda" },
            class: "form-select" %>
    </div>
  </div>

  <!-- Nro. Cuenta -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :account_number, "Nro. de Cuenta (Opcional)", class: "form-label" %>
      <%= form.text_field :account_number,
            placeholder: "0102-...",
            class: "form-input" %>
    </div>
  </div>

  <!-- Email -->
  <div class="form-row form-row--last">
    <div class="form-col">
      <%= form.label :email, "Correo asociado (Opcional)", class: "form-label" %>
      <%= form.email_field :email,
            placeholder: "correo@banco.com",
            class: "form-input" %>
    </div>
  </div>

  <!-- Acciones -->
  <div class="form-actions">
    <%= link_to "Cancelar", settings_path, class: "btn btn--ghost" %>
    <%= form.submit "Guardar Cuenta", class: "btn btn--teal" %>
  </div>

<% end %>
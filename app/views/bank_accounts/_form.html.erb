<%= form_with(model: bank_account, local: true) do |form| %>
  <div style="margin-bottom: 15px;">
    <%= form.label :institution, "Institución Bancaria*", style: "display: block; font-weight: 500; margin-bottom: 5px;" %>
    <%= form.text_field :institution, placeholder: "Ej. Banco Banesco / Zelle / Cash", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= form.label :currency, "Moneda*", style: "display: block; font-weight: 500; margin-bottom: 5px;" %>
    <%= form.select :currency, [["Bolívares (VES)", "VES"], ["Dólares (USD)", "USD"]], { prompt: "Seleccione moneda" }, style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= form.label :account_number, "Nro. de Cuenta (Opcional)", style: "display: block; font-weight: 500; margin-bottom: 5px;" %>
    <%= form.text_field :account_number, placeholder: "0102-...", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
  </div>

  <div style="margin-bottom: 25px;">
    <%= form.label :email, "Correo asociado (Opcional)", style: "display: block; font-weight: 500; margin-bottom: 5px;" %>
    <%= form.email_field :email, placeholder: "correo@banco.com", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
  </div>

  <div style="display: flex; justify-content: flex-end; gap: 10px;">
    <%= link_to "Cancelar", settings_path, style: "padding: 10px 20px; background: #e5e7eb; color: #374151; text-decoration: none; border-radius: 6px;" %>
    <%= form.submit "Guardar Cuenta", style: "padding: 10px 20px; background: #319795; color: white; border: none; border-radius: 6px; cursor: pointer;" %>
  </div>
<% end %>
<%= form_with(model: vehicle, html: { multipart: true }) do |form| %>

  <% if vehicle.errors.any? %>
    <div class="form-alert form-alert--danger">
      <h2 class="form-alert__title">
        <%= pluralize(vehicle.errors.count, "error") %> impidieron guardar el vehículo:
      </h2>
      <ul class="form-alert__list">
        <% vehicle.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- ==================== Información Básica ==================== -->
  <h2 class="form-section-heading">📋 Información Básica</h2>

  <div class="form-row">
    <div class="form-col">
      <%= form.label :plate, "Placa / Patente", class: "form-label form-label--required" %>
      <%= form.text_field :plate, required: true,
            placeholder: "Ej. ABC-123", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :brand, "Marca", class: "form-label form-label--required" %>
      <%= form.text_field :brand, required: true,
            placeholder: "Ej. Toyota, Chevrolet", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :model, "Modelo", class: "form-label form-label--required" %>
      <%= form.text_field :model, required: true,
            placeholder: "Ej. Hilux, Spark", class: "form-input" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-col">
      <%= form.label :vehicle_category_id, "Categoría / Tipo de Vehículo", class: "form-label" %>
      <%= form.collection_select :vehicle_category_id,
            VehicleCategory.order(:name), :id, :name,
            { include_blank: "Seleccionar categoría..." },
            class: "form-select" %>
    </div>
    <div class="form-col">
      <%= form.label :condition, "Condición", class: "form-label" %>
      <%= form.select :condition,
            [["Propio", "own"], ["Alquilado", "rented"]],
            {}, class: "form-select" %>
    </div>
    <div class="form-col">
      <%= form.label :status, "Estado Operativo", class: "form-label" %>
      <%= form.select :status,
            [["Disponible", "available"], ["En uso", "in_use"], ["Mantenimiento", "maintenance"]],
            {}, class: "form-select" %>
    </div>
  </div>

  <!-- ==================== Especificaciones Técnicas ==================== -->
  <h2 class="form-section-heading form-section-heading--spaced">⚙️ Especificaciones Técnicas</h2>

  <div class="form-row">
    <div class="form-col">
      <%= form.label :engine_serial, "Serial del Motor", class: "form-label" %>
      <%= form.text_field :engine_serial,
            placeholder: "Número de motor", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :body_serial, "Serial de Carrocería (NIV/VIN)", class: "form-label" %>
      <%= form.text_field :body_serial,
            placeholder: "Número de carrocería / chasis", class: "form-input" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-col">
      <%= form.label :color, "Color", class: "form-label" %>
      <%= form.text_field :color, placeholder: "Ej. Blanco, Negro", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :year, "Año", class: "form-label" %>
      <%= form.number_field :year, placeholder: "Ej. 2022", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :seats, "Cantidad de Puestos", class: "form-label" %>
      <%= form.number_field :seats, placeholder: "Ej. 5", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :load_capacity, "Capacidad Carga (Kg / Ton)", class: "form-label" %>
      <%= form.number_field :load_capacity, step: 0.01,
            placeholder: "Ej. 1200.00", class: "form-input" %>
    </div>
  </div>

  <!-- ==================== Seguro y Registro ==================== -->
  <h2 class="form-section-heading form-section-heading--spaced">
    🛡️ Seguro y Registro del Propietario
  </h2>

  <div class="form-row">
    <div class="form-col">
      <%= form.label :owner_dni, "Cédula o RIF del Propietario", class: "form-label" %>
      <%= form.text_field :owner_dni,
            placeholder: "Ej. V-12345678 / J-12345678-0", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :policy_number, "Número de Póliza de Seguro", class: "form-label" %>
      <%= form.text_field :policy_number,
            placeholder: "Número de póliza RCV/Todo Riesgo", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :policy_expiration, "Vencimiento del Seguro", class: "form-label" %>
      <%= form.date_field :policy_expiration, class: "form-input" %>
    </div>
  </div>

  <!-- ==================== Anexos ==================== -->
  <h2 class="form-section-heading form-section-heading--spaced">
    📎 Anexos y Documentos Digitales (PDF o Imagen)
  </h2>

  <div class="form-row form-row--last">
    <div class="form-dropzone form-dropzone--compact">
      <%= form.label :registration_title, "📄 Título de Registro",
            class: "form-label" %>
      <%= form.file_field :registration_title,
            accept: "application/pdf,image/*",
            class: "form-dropzone__input" %>
      <% if vehicle.registration_title.attached? %>
        <p class="form-dropzone__status">✓ Archivo cargado</p>
      <% end %>
    </div>

    <div class="form-dropzone form-dropzone--compact">
      <%= form.label :rcv_policy, "🛡️ Seguro RCV", class: "form-label" %>
      <%= form.file_field :rcv_policy,
            accept: "application/pdf,image/*",
            class: "form-dropzone__input" %>
      <% if vehicle.rcv_policy.attached? %>
        <p class="form-dropzone__status">✓ Archivo cargado</p>
      <% end %>
    </div>

    <div class="form-dropzone form-dropzone--compact">
      <%= form.label :owner_dni_file, "🪪 C.I. / RIF Propietario", class: "form-label" %>
      <%= form.file_field :owner_dni_file,
            accept: "application/pdf,image/*",
            class: "form-dropzone__input" %>
      <% if vehicle.owner_dni_file.attached? %>
        <p class="form-dropzone__status">✓ Archivo cargado</p>
      <% end %>
    </div>
  </div>

  <!-- ==================== Acciones ==================== -->
  <div class="form-actions">
    <%= link_to "Cancelar", vehicles_path, class: "btn btn--ghost" %>
    <%= form.submit "Guardar Vehículo", class: "btn btn--dark" %>
  </div>

<% end %>
<% content_for :title, "Vehículo - #{@vehicle.plate}" %>

<div class="page page--wide">

  <header class="page__header">
    <%= link_to "← Volver a Flota Vehicular", vehicles_path, class: "page__back" %>
    <div class="page__actions">
      <%= link_to "✏️ Editar Vehículo", edit_vehicle_path(@vehicle), class: "btn btn--ghost" %>
      <%= link_to "Eliminar", vehicle_path(@vehicle),
            data: { turbo_method: :delete,
                    turbo_confirm: "¿Estás seguro de eliminar este vehículo?" },
            class: "btn btn--danger" %>
    </div>
  </header>

  <!-- Hero: Placa + Marca + Modelo + Estado -->
  <div class="show-hero">
    <div class="show-hero__main">
      <div class="show-hero__tags">
        <span class="show-hero__title" style="font-size: 26px; color: var(--color-primary-dark);">
          <%= @vehicle.plate %>
        </span>

        <% if @vehicle.vehicle_category %>
          <span class="badge badge--blue">🏷️ <%= @vehicle.vehicle_category.name %></span>
        <% end %>
      </div>

      <p class="show-hero__desc" style="font-size: 16px;">
        <%= @vehicle.brand %> <%= @vehicle.model %>
        <%= "(#{@vehicle.year})" if @vehicle.year.present? %>
      </p>
    </div>

    <div style="text-align: right;">
      <% case @vehicle.status %>
      <% when "available" %>
        <span class="badge badge--success">Disponible</span>
      <% when "in_use" %>
        <span class="badge badge--warning">En Uso</span>
      <% when "maintenance" %>
        <span class="badge badge--danger">En Mantenimiento</span>
      <% end %>

      <div style="margin-top: 8px;">
        <% if @vehicle.condition == "own" %>
          <span class="badge badge--blue">Propio</span>
        <% else %>
          <span class="badge badge--purple">Alquilado</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Grid de especificaciones -->
  <div class="show-grid">

    <div class="show-card">
      <h2 class="show-card__title">⚙️ Especificaciones Técnicas</h2>

      <div class="show-card__field">
        <span class="show-card__label">Color:</span>
        <span class="show-card__value show-card__value--muted">
          <%= @vehicle.color.presence || "No especificado" %>
        </span>
      </div>
      <div class="show-card__field">
        <span class="show-card__label">Cantidad de Puestos:</span>
        <span class="show-card__value show-card__value--muted">
          <%= @vehicle.seats.presence || "-" %>
        </span>
      </div>
      <div class="show-card__field">
        <span class="show-card__label">Capacidad Carga:</span>
        <span class="show-card__value show-card__value--muted">
          <%= @vehicle.load_capacity.present? ? "#{@vehicle.load_capacity} Kg" : "N/A" %>
        </span>
      </div>
      <div class="show-card__field">
        <span class="show-card__label">Serial de Motor:</span>
        <span class="show-card__value show-card__value--muted">
          <%= @vehicle.engine_serial.presence || "No registrado" %>
        </span>
      </div>
      <div class="show-card__field">
        <span class="show-card__label">Serial Carrocería / VIN:</span>
        <span class="show-card__value show-card__value--muted">
          <%= @vehicle.body_serial.presence || "No registrado" %>
        </span>
      </div>
    </div>

    <div class="show-card">
      <h2 class="show-card__title">🛡️ Propietario y Seguro</h2>

      <div class="show-card__field">
        <span class="show-card__label">C.I. / RIF Propietario:</span>
        <span class="show-card__value show-card__value--muted">
          <%= @vehicle.owner_dni.presence || "No especificado" %>
        </span>
      </div>
      <div class="show-card__field">
        <span class="show-card__label">Número de Póliza:</span>
        <span class="show-card__value show-card__value--muted">
          <%= @vehicle.policy_number.presence || "Sin póliza" %>
        </span>
      </div>
      <div class="show-card__field">
        <span class="show-card__label">Vencimiento del Seguro:</span>
        <% if @vehicle.policy_expiration %>
          <% is_expired = @vehicle.policy_expiration < Date.current %>
          <span class="policy-status <%= 'policy-status--expired' if is_expired %>">
            <%= @vehicle.policy_expiration.strftime("%d/%m/%Y") %>
            <%= "(VENCIDA)" if is_expired %>
          </span>
        <% else %>
          <span class="policy-status--missing">No asignado</span>
        <% end %>
      </div>
    </div>

  </div>

  <!-- Documentos adjuntos -->
  <div class="show-card" style="margin-bottom: 25px;">
    <h2 class="show-card__title">📎 Documentos Digitales Anexados</h2>

    <div class="doc-grid">
      <div class="doc-tile">
        <span class="doc-tile__icon">📜</span>
        <span class="doc-tile__label">Título de Registro</span>
        <% if @vehicle.registration_title.attached? %>
          <span class="doc-tile__action">
            <%= link_to "Ver / Descargar",
                  rails_blob_path(@vehicle.registration_title, disposition: "inline"),
                  target: "_blank" %>
          </span>
        <% else %>
          <span class="doc-tile__empty">No adjuntado</span>
        <% end %>
      </div>

      <div class="doc-tile">
        <span class="doc-tile__icon">🛡️</span>
        <span class="doc-tile__label">Seguro RCV</span>
        <% if @vehicle.rcv_policy.attached? %>
          <span class="doc-tile__action">
            <%= link_to "Ver / Descargar",
                  rails_blob_path(@vehicle.rcv_policy, disposition: "inline"),
                  target: "_blank" %>
          </span>
        <% else %>
          <span class="doc-tile__empty">No adjuntado</span>
        <% end %>
      </div>

      <div class="doc-tile">
        <span class="doc-tile__icon">🆔</span>
        <span class="doc-tile__label">C.I. / RIF Propietario</span>
        <% if @vehicle.owner_dni_file.attached? %>
          <span class="doc-tile__action">
            <%= link_to "Ver / Descargar",
                  rails_blob_path(@vehicle.owner_dni_file, disposition: "inline"),
                  target: "_blank" %>
          </span>
        <% else %>
          <span class="doc-tile__empty">No adjuntado</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Historial de asignaciones -->
  <div class="table-card">
    <div class="show-history__header">
      <div>
        <h2 class="show-history__title">👥 Historial de Asignaciones a Empleados</h2>
        <span class="show-history__count"><%= @assignments.count %> registros</span>
      </div>
    </div>

    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Empleado</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th class="data-table__th--center">Estado</th>
          </tr>
        </thead>
        <tbody>
          <% if @assignments.any? %>
            <% @assignments.each do |assignment| %>
              <tr>
                <td>
                  <%= link_to "#{assignment.employee.name} #{assignment.employee.surname}",
                        employee_path(assignment.employee),
                        class: "data-table__product-link" %>
                </td>
                <td class="data-table__td--muted">
                  <%= assignment.start_date.present? ? assignment.start_date.strftime("%d/%m/%Y") : "-" %>
                </td>
                <td class="data-table__td--muted">
                  <%= assignment.end_date.present? ? assignment.end_date.strftime("%d/%m/%Y") : "Vigente" %>
                </td>
                <td class="data-table__td--center">
                  <% if assignment.end_date.nil? || assignment.end_date >= Date.current %>
                    <span class="badge badge--success">Activa</span>
                  <% else %>
                    <span class="badge badge--muted">Finalizada</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="data-table__empty">
                No hay registros de asignación para este vehículo.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>
<% content_for :title, "Flota Vehicular" %>

<div class="page page--wide">

  <header class="page__header">
    <div>
      <h1 class="page__title">🚗 Flota Vehicular</h1>
      <p class="page__subtitle">Gestión de la flota, especificaciones y estado operacional.</p>
    </div>
    <div class="page__actions">
      <% if can?("fleet", :write) %>
        <%= link_to "+ Nuevo Vehículo", new_vehicle_path, class: "btn btn--dark" %>
      <% end %>
    </div>
  </header>

  <!-- Métricas rápidas -->
  <div class="stats-bar">
    <div class="stat">
    <span class="stat__label">Total Vehículos</span>
    <p class="stat__value"><%= @total_vehicles %></p>
    </div>
    <div class="stat stat--success">
    <span class="stat__label">Disponibles</span>
    <p class="stat__value"><%= @available_vehicles %></p>
    </div>
    <div class="stat stat--warning">
    <span class="stat__label">En Uso</span>
    <p class="stat__value"><%= @in_use_vehicles %></p>
    </div>
    <div class="stat stat--danger">
    <span class="stat__label">Mantenimiento</span>
    <p class="stat__value"><%= @maintenance_vehicles %></p>
    </div>
  </div>

  <!-- Tabla -->
  <div class="table-card">
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Placa / Marca / Modelo</th>
            <th>Categoría</th>
            <th class="data-table__th--center">Condición</th>
            <th class="data-table__th--center">Estado</th>
            <th>Seguro / Vencimiento</th>
            <th class="data-table__th--center">Anexos</th>
            <th class="data-table__th--right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if @vehicles.any? %>
            <% @vehicles.each do |vehicle| %>
              <tr>
                <!-- Placa / Marca / Modelo -->
                <td>
                  <span class="data-table__plate"><%= vehicle.plate %></span>
                  <span class="data-table__meta">
                    <%= vehicle.brand %> <%= vehicle.model %>
                    <%= "(#{vehicle.year})" if vehicle.year.present? %>
                  </span>
                </td>

                <!-- Categoría -->
                <td>
                  <% if vehicle.vehicle_category %>
                    <span class="badge badge--blue">🏷️ <%= vehicle.vehicle_category.name %></span>
                  <% else %>
                    <span class="attachments__empty">Sin categoría</span>
                  <% end %>
                </td>

                <!-- Condición -->
                <td class="data-table__td--center">
                  <% if vehicle.condition == "own" %>
                    <span class="badge badge--blue">Propio</span>
                  <% else %>
                    <span class="badge badge--purple">Alquilado</span>
                  <% end %>
                </td>

                <!-- Estado -->
                <td class="data-table__td--center">
                  <% case vehicle.status %>
                  <% when "available" %>
                    <span class="badge badge--success">Disponible</span>
                  <% when "in_use" %>
                    <span class="badge badge--warning">En Uso</span>
                  <% when "maintenance" %>
                    <span class="badge badge--danger">Mantenimiento</span>
                  <% end %>
                </td>

                <!-- Seguro -->
                <td>
                  <% if vehicle.policy_number.present? %>
                    <div class="data-table__policy">Póliza: <%= vehicle.policy_number %></div>
                    <% if vehicle.policy_expiration %>
                      <% is_expired = vehicle.policy_expiration < Date.current %>
                      <div class="data-table__policy-date <%= 'data-table__policy-date--expired' if is_expired %>">
                        Vence: <%= vehicle.policy_expiration.strftime("%d/%m/%Y") %>
                        <%= "(Vencida)" if is_expired %>
                      </div>
                    <% end %>
                  <% else %>
                    <span class="attachments__empty">Sin póliza</span>
                  <% end %>
                </td>

                <!-- Anexos -->
                <td class="data-table__td--center">
                  <div class="attachments">
                    <% if vehicle.registration_title.attached? %>
                      <%= link_to rails_blob_path(vehicle.registration_title, disposition: "inline"),
                            target: "_blank",
                            title: "Título de Propiedad / Registro",
                            class: "attachment-link" do %>
                        📜
                      <% end %>
                    <% end %>

                    <% if vehicle.rcv_policy.attached? %>
                      <%= link_to rails_blob_path(vehicle.rcv_policy, disposition: "inline"),
                            target: "_blank",
                            title: "Póliza RCV",
                            class: "attachment-link" do %>
                        🛡️
                      <% end %>
                    <% end %>

                    <% if vehicle.owner_dni_file.attached? %>
                      <%= link_to rails_blob_path(vehicle.owner_dni_file, disposition: "inline"),
                            target: "_blank",
                            title: "Cédula / Documento Propietario",
                            class: "attachment-link" do %>
                        🆔
                      <% end %>
                    <% end %>

                    <% unless vehicle.registration_title.attached? || vehicle.rcv_policy.attached? || vehicle.owner_dni_file.attached? %>
                      <span class="attachments__empty">-</span>
                    <% end %>
                  </div>
                </td>

                <!-- Acciones -->
                <td class="data-table__td--right">
                  <%= link_to "Ver", vehicle_path(vehicle),
                        class: "action-link action-link--view" %>
                  <%= link_to "Editar", edit_vehicle_path(vehicle),
                        class: "action-link action-link--edit" %>
                  <%= link_to "Eliminar", vehicle_path(vehicle),
                        data: { turbo_method: :delete,
                                turbo_confirm: "¿Estás seguro de eliminar este vehículo?" },
                        class: "action-link action-link--delete" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="data-table__empty">
                🚘 No hay vehículos registrados en la flota todavía.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
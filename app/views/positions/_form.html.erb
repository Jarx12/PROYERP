<%= form_with(model: position) do |form| %>

  <% if position.errors.any? %>
    <div class="form-alert form-alert--danger">
      <h2 class="form-alert__title">
        <%= pluralize(position.errors.count, "error") %> impiden guardar el cargo:
      </h2>
      <ul class="form-alert__list">
        <% position.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Título -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :title, "Nombre del Cargo / Puesto",
            class: "form-label form-label--required" %>
      <%= form.text_field :title,
            placeholder: "Ej. Operador de Almacén, Chofer, Analista de Sistemas...",
            class: "form-input" %>
    </div>
  </div>

  <!-- Descripción -->
  <div class="form-row form-row--last">
    <div class="form-col">
      <%= form.label :description, "Descripción o Responsabilidades (Opcional)",
            class: "form-label" %>
      <%= form.text_area :description, rows: 4,
            placeholder: "Resumen opcional de las funciones asociadas a este cargo...",
            class: "form-input form-textarea" %>
    </div>
  </div>

  <!-- Acciones -->
  <div class="form-actions">
    <%= link_to "Cancelar", settings_path, class: "btn btn--ghost" %>
    <%= form.submit "Guardar Cargo", class: "btn btn--primary" %>
  </div>

<% end %>
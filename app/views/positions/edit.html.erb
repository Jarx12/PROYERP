<% content_for :title, "Editar Cargo: #{@position.title}" %>

<div style="font-family: Arial, sans-serif; padding: 40px 20px; max-width: 600px; margin: 0 auto; line-height: 1.25;">

  <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
    <%= link_to "← Volver a Cargos", positions_path, style: "color: #718096; text-decoration: none; font-size: 14px; font-weight: bold;" %>
  </div>

  <div style="background-color: white; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); padding: 30px;">
    
    <div style="border-bottom: 1px solid #edf2f7; padding-bottom: 15px; margin-bottom: 25px;">
      <h1 style="color: #1a202c; font-size: 22px; margin: 0; font-weight: bold;">📝 Editar Cargo</h1>
      <p style="color: #718096; font-size: 14px; margin: 5px 0 0 0;">Modifica los detalles del puesto: <strong><%= @position.title %></strong></p>
    </div>

    <%= render "form", position: @position %>

  </div>

</div>
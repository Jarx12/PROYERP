<% content_for :title, "Cargos y Puestos" %>

<div style="font-family: Arial, sans-serif; padding: 40px 20px; max-width: 950px; margin: 0 auto; line-height: 1.25;">

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
    <div>
      <h1 style="color: #1a202c; font-size: 26px; margin: 0; font-weight: bold;">💼 Cargos y Puestos</h1>
      <p style="color: #718096; margin: 5px 0 0 0; font-size: 14px;">Administración de cargos para los empleados de la empresa.</p>
    </div>
    <div style="display: flex; gap: 10px;">
      <%= link_to "👥 Ver Empleados", employees_path, style: "padding: 10px 16px; border: 1px solid #cbd5e0; border-radius: 6px; color: #4a5568; text-decoration: none; font-size: 14px; font-weight: bold; background-color: white;" %>
      <%= link_to "+ Nuevo Cargo", new_position_path, style: "padding: 10px 18px; border-radius: 6px; color: white; text-decoration: none; font-size: 14px; font-weight: bold; background-color: #3182ce;" %>
    </div>
  </div>

  <div style="background-color: white; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); overflow: hidden;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
      <thead>
        <tr style="border-bottom: 2px solid #e2e8f0; color: #718096; font-size: 12px; text-transform: uppercase; background-color: #f7fafc;">
          <th style="padding: 14px 20px;">Nombre del Cargo</th>
          <th style="padding: 14px 20px; text-align: center;">Empleados Asignados</th>
          <th style="padding: 14px 20px; text-align: right;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @positions.each do |pos| %>
          <tr style="border-bottom: 1px solid #edf2f7; color: #2d3748;">
            <td style="padding: 14px 20px;">
              <strong style="display: block; color: #1a202c;"><%= pos.title %></strong>
              <span style="font-size: 12px; color: #718096;"><%= truncate(pos.description, length: 60) %></span>
            </td>
            <td style="padding: 14px 20px; text-align: center;">
              <span style="background-color: #edf2f7; color: #4a5568; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold;">
                <%= pos.employees.count %>
              </span>
            </td>
            <td style="padding: 14px 20px; text-align: right;">
              <%= link_to "Editar", edit_position_path(pos), style: "color: #4a5568; text-decoration: none; font-weight: bold; margin-right: 10px;" %>
              <%= link_to "Eliminar", position_path(pos), data: { turbo_method: :delete, turbo_confirm: "¿Deseas eliminar este cargo?" }, style: "color: #e53e3e; text-decoration: none; font-weight: bold;" %>
            </td>
          </tr>
        <% end %>

        <% if @positions.none? %>
          <tr>
            <td colspan="4" style="padding: 30px; text-align: center; color: #a0aec0;">
              No hay cargos creados aún. <%= link_to "Crear el primero", new_position_path, style: "color: #3182ce; font-weight: bold;" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>
<% content_for :title, "Configuración del Sistema" %>

<div class="page page--wide">

  <header class="page__header">
    <div>
      <h1 class="page__title">⚙️ Configuración General del ERP</h1>
      <p class="page__subtitle">Administre los parámetros globales del sistema segmentados por módulo.</p>
    </div>
  </header>

  <!-- Navegación de pestañas -->
  <div class="tabs" role="tablist">
    <button type="button" class="tab-link is-active" data-tab-target="tab-inventario">📦 Inventario</button>
    <button type="button" class="tab-link"           data-tab-target="tab-proyectos">📁 Proyectos</button>
    <button type="button" class="tab-link"           data-tab-target="tab-rrhh">👨‍💼 RRHH</button>
    <button type="button" class="tab-link"           data-tab-target="tab-vehiculos">🚗 Vehículos</button>
    <button type="button" class="tab-link"           data-tab-target="tab-finanzas">📊 Finanzas</button>
    <% if can?("users") %>
      <button type="button" class="tab-link"         data-tab-target="tab-usuarios">🔐 Usuarios</button>
    <% end %>
  </div>

  <!-- ===================== Inventario ===================== -->
  <div id="tab-inventario" class="tab-content is-active">

    <div class="settings-card">
      <div class="settings-card__header">
        <h2 class="settings-card__title">🏷️ Categorías de Productos</h2>
        <%= link_to "+ Nueva", new_category_path, class: "settings-card__cta" %>
      </div>
      <table class="settings-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th class="is-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% Category.all.each do |cat| %>
            <tr>
              <td class="settings-table__name"><%= cat.name %></td>
              <td class="settings-table__actions">
                <%= link_to "Editar", edit_category_path(cat), class: "link-inline" %>
                <%= button_to "Eliminar", category_path(cat),
                      method: :delete,
                      data: { turbo_confirm: "¿Eliminar categoría?" },
                      class: "btn-inline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="settings-card">
      <div class="settings-card__header">
        <h2 class="settings-card__title">🏭 Almacenes</h2>
        <%= link_to "+ Nuevo", new_warehouse_path, class: "settings-card__cta" %>
      </div>
      <table class="settings-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Código</th>
            <th class="is-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% Warehouse.all.each do |wh| %>
            <tr>
              <td class="settings-table__name"><%= wh.name %></td>
              <td class="settings-table__meta"><%= wh.code %></td>
              <td class="settings-table__actions">
                <%= link_to "Editar", edit_warehouse_path(wh), class: "link-inline" %>
                <%= button_to "Eliminar", warehouse_path(wh),
                      method: :delete,
                      data: { turbo_confirm: "¿Eliminar almacén?" },
                      class: "btn-inline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
  <!-- ===================== Proyectos ===================== -->
  <div id="tab-proyectos" class="tab-content">
    <div class="settings-card settings-card--projects">
      <div class="settings-card__header">
        <div>
          <h2 class="settings-card__title">📁 Proyectos</h2>
          <p class="settings-card__subtitle">
            Administre los proyectos publicados en el portafolio de la empresa.
          </p>
        </div>
        <div class="settings-card__header-actions">
          <span class="settings-card__count"><%= @projects.size %> registrados</span>
          <%= link_to "+ Crear Proyecto", new_project_path,
                class: "settings-card__cta" %>
        </div>
      </div>

      <% if @projects.any? %>
        <div class="settings-projects__list">
          <table class="settings-table">
            <thead>
              <tr>
                <th>Nombre</th>
                <th>Cliente</th>
                <th>Ubicación</th>
                <th>Período</th>
                <th class="is-right">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% @projects.each do |project| %>
                <tr>
                  <td class="settings-table__name"><%= project.name %></td>
                  <td class="settings-table__meta"><%= project.customer.presence || "No especificado" %></td>
                  <td class="settings-table__meta"><%= project.location.presence || "No especificada" %></td>
                  <td class="settings-table__meta">
                    <%= project.start_date&.strftime("%d/%m/%Y") || "Sin fecha" %>
                    <% if project.end_date %>
                      – <%= project.end_date.strftime("%d/%m/%Y") %>
                    <% end %>
                  </td>
                  <td class="settings-table__actions">
                    <%= link_to "Editar", edit_project_path(project), class: "link-inline" %>
                    <%= button_to "Eliminar", project_path(project),
                          method: :delete,
                          data: { turbo_confirm: "¿Eliminar el proyecto #{project.name}?" },
                          class: "btn-inline-danger" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="data-table__empty">
          Todavía no hay proyectos registrados.
          <%= link_to "Crear el primer proyecto", new_project_path, class: "link-inline" %>.
        </div>
      <% end %>
    </div>
  </div>

  <!-- ===================== RRHH ===================== -->
  <div id="tab-rrhh" class="tab-content">
    <div class="settings-card">
      <div class="settings-card__header">
        <h2 class="settings-card__title">💼 Cargos</h2>
        <%= link_to "+ Nuevo", new_position_path, class: "settings-card__cta" %>
      </div>
      <table class="settings-table">
        <tbody>
          <% Position.all.each do |pos| %>
            <tr>
              <td class="settings-table__name"><%= pos.title %></td>
              <td class="settings-table__actions">
                <%= link_to "Editar", edit_position_path(pos), class: "link-inline" %>
                <%= button_to "Eliminar", position_path(pos),
                      method: :delete,
                      data: { turbo_confirm: "¿Eliminar cargo?" },
                      class: "btn-inline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ===================== Vehículos ===================== -->
  <div id="tab-vehiculos" class="tab-content">
    <div class="settings-card">
      <div class="settings-card__header">
        <h2 class="settings-card__title">🚘 Tipos / Categorías de Vehículos</h2>
        <%= link_to "+ Nueva", new_vehicle_category_path, class: "settings-card__cta" %>
      </div>
      <table class="settings-table">
        <tbody>
          <% VehicleCategory.all.each do |v_cat| %>
            <tr>
              <td class="settings-table__name"><%= v_cat.name %></td>
              <td class="settings-table__actions">
                <%= link_to "Editar", edit_vehicle_category_path(v_cat), class: "link-inline" %>
                <%= button_to "Eliminar", vehicle_category_path(v_cat),
                      method: :delete,
                      data: { turbo_confirm: "¿Eliminar tipo de vehículo?" },
                      class: "btn-inline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ===================== Finanzas ===================== -->
  <div id="tab-finanzas" class="tab-content">

    <div class="settings-card settings-card--teal">
      <div class="settings-card__header">
        <h2 class="settings-card__title">🏦 Cuentas Bancarias</h2>
        <%= link_to "+ Nueva Cuenta", new_bank_account_path,
              class: "settings-card__cta settings-card__cta--teal" %>
      </div>
      <table class="settings-table">
        <tbody>
          <% BankAccount.all.each do |acc| %>
            <tr>
              <td class="settings-table__name"><%= acc.display_name %></td>
              <td class="settings-table__actions">
                <%= link_to "Editar", edit_bank_account_path(acc), class: "link-inline" %>
                <%# Eliminar deshabilitado intencionalmente %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="settings-card settings-card--orange">
      <div class="settings-card__header">
        <h2 class="settings-card__title">🏷️ Categorías Financieras</h2>
        <%= link_to "+ Nueva", new_transaction_category_path,
              class: "settings-card__cta settings-card__cta--orange" %>
      </div>
      <table class="settings-table">
        <tbody>
          <% TransactionCategory.all.each do |tcat| %>
            <tr>
              <td class="settings-table__name"><%= tcat.name %></td>
              <td class="settings-table__actions">
                <%= link_to "Editar", edit_transaction_category_path(tcat), class: "link-inline" %>
                <%= button_to "Eliminar", transaction_category_path(tcat),
                      method: :delete,
                      data: { turbo_confirm: "¿Eliminar categoría?" },
                      class: "btn-inline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
  <!-- ===================== Usuarios ===================== -->
  <% if can?("users") %>
    <div id="tab-usuarios" class="tab-content">
      <div class="settings-card">
        <div class="settings-card__header">
          <div>
            <h2 class="settings-card__title">🔐 Usuarios y Permisos</h2>
            <p class="settings-card__subtitle">
              Cree usuarios con acceso restringido y asigne lectura o escritura por módulo.
            </p>
          </div>
          <div class="settings-card__header-actions">
            <%= link_to "Gestionar", users_path, class: "settings-card__cta settings-card__cta--teal" %>
          </div>
        </div>
        <p class="settings-card__subtitle">
          El superusuario tiene acceso total a todos los módulos. Los usuarios sin
          permiso de lectura no ven el módulo en el menú ni pueden acceder a él.
        </p>
      </div>
    </div>
  <% end %>
</div>

<script>
  (function () {
    const STORAGE_KEY = "activeSettingsTab";

    function activateTab(tabId) {
      document.querySelectorAll(".tab-content").forEach((el) => {
        el.classList.toggle("is-active", el.id === tabId);
      });
      document.querySelectorAll(".tab-link").forEach((btn) => {
        btn.classList.toggle("is-active", btn.dataset.tabTarget === tabId);
      });
      localStorage.setItem(STORAGE_KEY, tabId);
    }

    function init() {
      const tabs = document.querySelectorAll(".tab-link");
      if (!tabs.length) return;

      tabs.forEach((btn) => {
        btn.addEventListener("click", () => activateTab(btn.dataset.tabTarget));
      });

      const saved = localStorage.getItem(STORAGE_KEY) || "tab-inventario";
      const target = document.getElementById(saved);
      activateTab(target ? saved : "tab-inventario");
    }

    document.addEventListener("turbo:load", init);
    document.addEventListener("DOMContentLoaded", init);
  })();
</script>
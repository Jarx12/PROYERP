<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "ERP System" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= yield :page_styles %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= public_layout? ? "public-body" : "erp-body" %>" style="margin: 0; padding: 0; background-color: #f7fafc;">
    <% if public_layout? %>
      <%= render "layouts/public_header" %>
    <% else %>
      <%= render "layouts/header" %>
    <% end %>

    <% if notice.present? %>
      <div style="max-width: 1200px; margin: 15px auto 0 auto; padding: 12px 20px; background-color: #c6f6d5; border-left: 4px solid #38a169; color: #22543d; border-radius: 4px; font-family: Arial, sans-serif; font-size: 14px;">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div style="max-width: 1200px; margin: 15px auto 0 auto; padding: 12px 20px; background-color: #fed7d7; border-left: 4px solid #e53e3e; color: #742a2a; border-radius: 4px; font-family: Arial, sans-serif; font-size: 14px;">
        <%= alert %>
      </div>
    <% end %>

    <main class="<%= public_layout? ? "public-main" : "erp-main" %>" style="min-height: calc(100vh - 120px);">
      <%= yield %>
    </main>

    <% if public_layout? %>
      <%= render "layouts/public_footer" %>
    <% end %>
  </body>
</html>

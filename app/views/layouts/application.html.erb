<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "ERP System" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="margin: 0; padding: 0; background-color: #f7fafc;">
    
    <%= render "layouts/header" %>

    <% if notice.present? %>
      <div style="max-width: 1200px; margin: 15px auto 0 auto; padding: 12px 20px; background-color: #c6f6d5; border-left: 4px solid #38a169; color: #22543d; border-radius: 4px; font-family: Arial, sans-serif; font-size: 14px;">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div style="max-width: 1200px; margin: 15px auto 0 auto; padding: 12px 20px; background-color: #fed7d7; border-left: 4px solid #e53e3e; color: #742a2a; border-radius: 4px; font-family: Arial, sans-serif; font-size: 14px;">
        <%= alert %>
      </div>
    <% end %>

    <main style="min-height: calc(100vh - 120px);">
      <%= yield %>
    </main>

  </body>
</html>
<%= form_with(model: vehicle_category) do |form| %>

  <% if vehicle_category.errors.any? %>
    <div class="form-alert form-alert--danger">
      <h2 class="form-alert__title">
        <%= pluralize(vehicle_category.errors.count, "error") %> impidieron guardar la categoría:
      </h2>
      <ul class="form-alert__list">
        <% vehicle_category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Nombre -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :name, "Nombre de la Categoría",
            class: "form-label form-label--required" %>
      <%= form.text_field :name, required: true,
            placeholder: "Ej. Sedán, PickUp, Panel",
            class: "form-input" %>
    </div>
  </div>

  <!-- Descripción -->
  <div class="form-row form-row--last">
    <div class="form-col">
      <%= form.label :description, "Descripción", class: "form-label" %>
      <%= form.text_area :description, rows: 3,
            placeholder: "Detalles o uso del tipo de vehículo...",
            class: "form-input form-textarea" %>
    </div>
  </div>

  <!-- Acciones -->
  <div class="form-actions">
    <%= link_to "Cancelar", settings_path, class: "btn btn--ghost" %>
    <%= form.submit "Guardar Categoría", class: "btn btn--primary" %>
  </div>

<% end %>
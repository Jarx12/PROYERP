      title: "📝 Editar Documento",
      subtitle: "Modifique los metadatos o actualice el archivo del registro.",
      back: back_link_for(@document,
              labels: {
                record: "← Volver a la ficha del documento",
                index:  "← Volver al repositorio"
              }) do %>

  <%= render "form", document: @document %>

<% end %>
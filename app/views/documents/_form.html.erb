<%= form_with(model: document, local: true, html: { style: "line-height: 1.25; font-family: Arial, sans-serif;" }) do |form| %>
  
  <% if document.errors.any? %>
    <div style="background-color: #fff5f5; border: 1px solid #fed7d7; color: #c53030; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
      <h2 style="font-size: 16px; margin-top: 0; font-weight: bold;"><%= pluralize(document.errors.count, "error") %> impiden guardar este documento:</h2>
      <ul style="margin: 5px 0 0 0; padding-left: 20px; font-size: 14px;">
        <% document.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 20px;">
    <%= form.label :title, "Título del Documento", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 5px; font-size: 14px;" %>
    <%= form.text_field :title, placeholder: "Ej. Contrato de Trabajo de Juan", style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748;" %>
  </div>

  <div style="margin-bottom: 20px;">
    <%= form.label :employee_id, "Asignación del Documento", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 5px; font-size: 14px;" %>
    <%= form.collection_select :employee_id, Employee.all, :id, ->(e) { "#{e.name} #{e.surname} (C.I. #{e.cedula})" }, { prompt: "🏢 Documento General de la Compañía (Sin asignar a empleado)" }, { style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; background-color: white; box-sizing: border-box; font-size: 14px; color: #2d3748;" } %>
  </div>

  <div style="display: flex; gap: 20px; margin-bottom: 20px;">
    <div style="flex: 1;">
      <%= form.label :category, "Categoría", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 5px; font-size: 14px;" %>
      <%= form.select :category, Document.categories.keys.map { |k| [k.humanize, k] }, {}, { style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; background-color: white; box-sizing: border-box; font-size: 14px; color: #2d3748;" } %>
    </div>

    <div style="flex: 1;">
      <%= form.label :status, "Estado Inicial", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 5px; font-size: 14px;" %>
      <%= form.select :status, Document.statuses.keys.map { |k| [k.humanize, k] }, {}, { style: "width: 100%; padding: 10px; border: 1px solid #cbd5e0; border-radius: 6px; background-color: white; box-sizing: border-box; font-size: 14px; color: #2d3748;" } %>
    </div>
  </div>

  <div style="margin-bottom: 30px; padding: 20px; border: 2px dashed #cbd5e0; border-radius: 6px; background-color: #f7fafc; text-align: center;">
    <%= form.label :file, "📁 Seleccionar Archivo Físico", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 8px; font-size: 14px; cursor: pointer;" %>
    <span style="display: block; color: #718096; font-size: 12px; margin-bottom: 12px;">Formatos aceptados: PDF, Word, Imágenes (Máx. 10MB)</span>
    <div style="display: inline-block;">
      <%= form.file_field :file, style: "font-size: 14px; color: #4a5568;" %>
    </div>
  </div>

  <div style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e2e8f0; padding-top: 20px;">
    <%= link_to "Cancelar", documents_path, style: "padding: 10px 18px; border: 1px solid #cbd5e0; border-radius: 6px; color: #4a5568; text-decoration: none; font-size: 14px; font-weight: bold; background-color: white;" %>
    <%= form.submit "Subir Documento", style: "padding: 10px 18px; border: none; border-radius: 6px; color: white; background-color: #dd6b20; font-size: 14px; font-weight: bold; cursor: pointer;" %>
  </div>

<% end %>
<%= form_with(model: document) do |form| %>

  <% if document.errors.any? %>
    <div class="form-alert form-alert--danger">
      <h2 class="form-alert__title">
        <%= pluralize(document.errors.count, "error") %> impiden guardar este documento:
      </h2>
      <ul class="form-alert__list">
        <% document.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Título -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :title, "Título del Documento", class: "form-label form-label--required" %>
      <%= form.text_field :title,
            placeholder: "Ej. Contrato de Trabajo de Juan",
            class: "form-input" %>
    </div>
  </div>

  <!-- Asignación -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :employee_id, "Asignación del Documento", class: "form-label" %>
      <%= form.collection_select :employee_id,
            Employee.order(:surname, :name), :id,
            ->(e) { "#{e.name} #{e.surname} (C.I. #{e.cedula})" },
            { prompt: "🏢 Documento General de la Compañía (Sin asignar a empleado)" },
            class: "form-select" %>
    </div>
  </div>

  <!-- Categoría + Estado -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :category, "Categoría", class: "form-label" %>
      <%= form.select :category,
            Document.categories.keys.map { |k| [k.humanize, k] },
            {},
            class: "form-select" %>
    </div>

    <div class="form-col">
      <%= form.label :status, "Estado Inicial", class: "form-label" %>
      <%= form.select :status,
            Document.statuses.keys.map { |k| [k.humanize, k] },
            {},
            class: "form-select" %>
    </div>
  </div>

  <!-- Dropzone de archivo -->
  <div class="form-dropzone">
    <%= form.label :file, "📁 Seleccionar Archivo Físico", class: "form-dropzone__label" %>
    <span class="form-dropzone__hint">
      Formatos aceptados: PDF, Word, Imágenes (Máx. 10MB)
    </span>
    <div>
      <%= form.file_field :file, class: "form-dropzone__input" %>
    </div>
  </div>

  <!-- Acciones -->
  <div class="form-actions">
    <%= link_to "Cancelar", documents_path, class: "btn btn--ghost" %>
    <%= form.submit "Subir Documento", class: "btn btn--warning" %>
  </div>

<% end %>
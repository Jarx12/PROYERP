<% content_for :title, "Repositorio de Documentos" %>

<div class="page page--wide">

  <header class="page__header">
    <div>
      <h1 class="page__title">📄 Repositorio de Documentos</h1>
      <p class="page__subtitle">Gestión de archivos, contratos y anexos del personal.</p>
    </div>
    <div class="page__actions">
      <% if can?("documents", :write) %>
        <%= link_to "➕ Nuevo Documento", new_document_path, class: "btn btn--warning" %>
      <% end %>
    </div>
  </header>

  <div class="table-card">
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Título</th>
            <th>Asociado a</th>
            <th>Categoría</th>
            <th>Estado</th>
            <th class="data-table__th--center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if @documents.any? %>
            <% @documents.each do |document| %>
              <tr>
                <td class="data-table__name"><%= document.title %></td>

                <td>
                  <% if document.employee %>
                    <%= "#{document.employee.name} #{document.employee.surname}" %>
                  <% else %>
                    <span class="badge badge--blue">🏢 Compañía (General)</span>
                  <% end %>
                </td>

                <td>
                  <span class="badge badge--muted"><%= document.category.humanize %></span>
                </td>

                <td>
                  <% case document.status.to_sym %>
                  <% when :active %>
                    <span class="badge badge--success"><%= document.status.humanize %></span>
                  <% when :draft %>
                    <span class="badge badge--warning"><%= document.status.humanize %></span>
                  <% else %>
                    <span class="badge badge--muted"><%= document.status.humanize %></span>
                  <% end %>
                </td>

                <td class="data-table__td--center">
                  <div class="data-table__actions">
                    <%= link_to "Ver Detalle", document_path(document),
                          class: "action-link action-link--view" %>

                    <% if document.file.attached? %>
                      <%= link_to "Descargar",
                            rails_blob_path(document.file, disposition: "attachment"),
                            class: "action-link action-link--edit" %>
                    <% else %>
                      <span class="badge badge--danger">Sin archivo</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="data-table__empty">
                No hay documentos registrados en el repositorio.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= link_to "← Volver al Inicio", root_path, class: "page__back" %>
</div>
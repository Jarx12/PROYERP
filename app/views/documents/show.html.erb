<% content_for :title, "Documento: #{@document.title}" %>

<div class="page page--narrow">

  <header class="page__header">
    <%= link_to "← Volver al repositorio", documents_path, class: "page__back" %>
    <div class="page__actions">
      <%= link_to "📝 Editar Registro", edit_document_path(@document), class: "btn btn--warning" %>
    </div>
  </header>

  <!-- Hero: título + metadatos clave -->
  <div class="show-hero">
    <div class="show-hero__main">
      <div class="show-hero__tags">
        <span class="badge badge--muted"><%= @document.category.humanize %></span>
        <span class="badge badge--<%= @document.status == "active" ? "success" : "warning" %>">
          <%= @document.status.humanize %>
        </span>
      </div>

      <h1 class="show-hero__title"><%= @document.title %></h1>
      <p class="show-hero__desc">
        Registrado el <%= @document.created_at.strftime("%d/%m/%Y a las %H:%M") %>
      </p>
    </div>
  </div>

  <!-- Grid de metadatos -->
  <div class="show-grid">

    <div class="show-card">
      <h2 class="show-card__title">👤 Asignación</h2>
      <div class="show-card__field">
        <% if @document.employee %>
          <span class="show-card__label">Empleado:</span>
          <span class="show-card__value">
            <%= "#{@document.employee.name} #{@document.employee.surname}" %>
          </span>
          <span class="show-card__label">C.I. <%= @document.employee.cedula %></span>
        <% else %>
          <span class="badge badge--blue">🏢 Empresa (General)</span>
        <% end %>
      </div>
    </div>

    <div class="show-card">
      <h2 class="show-card__title">📄 Detalles</h2>
      <div class="show-card__field">
        <span class="show-card__label">Categoría:</span>
        <span class="show-card__value"><%= @document.category.humanize %></span>
      </div>
      <div class="show-card__field">
        <span class="show-card__label">Estado:</span>
        <span class="show-card__value"><%= @document.status.humanize %></span>
      </div>
    </div>

  </div>

  <!-- Archivo adjunto -->
  <div class="show-card">
    <h2 class="show-card__title">📎 Archivo Adjunto</h2>

    <% if @document.file.attached? %>
      <div class="show-card__field">
        <span class="show-card__value">
          <%= @document.file.filename %>
        </span>
        <span class="show-card__label">
          <%= number_to_human_size(@document.file.byte_size) %>
        </span>
      </div>

      <div class="form-actions">
        <%= link_to "👁️ Ver en el navegador",
              rails_blob_path(@document.file, disposition: "inline"),
              target: "_blank",
              class: "btn btn--primary" %>
        <%= link_to "📥 Descargar archivo",
              rails_blob_path(@document.file, disposition: "attachment"),
              class: "btn btn--success" %>
      </div>
    <% else %>
      <div class="form-alert form-alert--danger" style="margin-bottom: 0;">
        ⚠️ Este registro no tiene ningún archivo físico adjunto.
      </div>
    <% end %>
  </div>

</div>
<% content_for :title, "Empleados Desactivados" %>

<div class="page page--wide">

  <header class="page__header">
    <div>
      <h1 class="page__title">🗑️ Empleados Inactivos / Desactivados</h1>
      <p class="page__subtitle">
        Histórico de personal retirado o dado de baja de la organización.
      </p>
    </div>
    <div class="page__actions">
      <%= link_to "← Volver a Empleados Activos", employees_path, class: "btn btn--ghost" %>
    </div>
  </header>

  <!-- Métricas -->
  <div class="stats-bar">
    <div class="stat stat--danger">
      <span class="stat__label">Total Desactivados</span>
      <p class="stat__value"><%= @discarded_employees.count %></p>
    </div>
    <div class="stat">
      <span class="stat__label">Total Activos</span>
      <p class="stat__value"><%= @active_employees_count %></p>
    </div>
  </div>

  <!-- Tabla -->
  <div class="table-card">
    <div class="table-scroll">
      <table class="data-table data-table--danger">
        <thead>
          <tr>
            <th>Empleado / Cédula</th>
            <th>Cargo</th>
            <th>Contacto</th>
            <th class="data-table__th--center">Fecha Desactivación</th>
            <th class="data-table__th--right">Acción</th>
          </tr>
        </thead>
        <tbody>
          <% if @discarded_employees.any? %>
            <% @discarded_employees.each do |employee| %>
              <tr>
                <td>
                  <span class="data-table__name">
                    <%= "#{employee.surname} #{employee.surname2}, #{employee.name} #{employee.name2}" %>
                  </span>
                  <span class="data-table__meta">🪪 V-<%= employee.cedula %></span>
                </td>

                <td>
                  <% if employee.position %>
                    <span class="badge badge--muted">💼 <%= employee.position.title %></span>
                  <% else %>
                    <span class="attachments__empty">Sin Cargo</span>
                  <% end %>
                </td>

                <td class="data-table__td--muted">
                  📞 <%= employee.telefono.presence || "N/A" %>
                </td>

                <td class="data-table__td--center data-table__td--muted">
                  <%= employee.discarded_at&.strftime("%d/%m/%Y %H:%M") || "N/A" %>
                </td>

                <td class="data-table__td--right">
                  <%= link_to restore_employee_path(employee),
                        data: { turbo_method: :patch,
                                turbo_confirm: "¿Deseas reactivar al empleado #{employee.name} #{employee.surname}?" },
                        class: "btn btn--success btn--sm" do %>
                    🔄 Reactivar
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="data-table__empty">
                🎉 No hay ningún empleado inactivo.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
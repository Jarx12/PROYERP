<% content_for :title, "Empleados" %>

<div class="page">

  <header class="page__header">
    <div>
      <h1 class="page__title">👨‍💼 Personal y Nómina</h1>
      <p class="page__subtitle">Directorio de trabajadores y salarios.</p>
    </div>

    <div class="page__actions">
      <% if can?("hr", :write) %>
        <%= link_to "+ Nuevo Empleado", new_employee_path, class: "btn btn--success" %>
        <%= link_to "💳 Pago de Nómina en Masa",
              bulk_payroll_employees_path, class: "btn btn--primary" %>
      <% end %>
    </div>
  </header>

  <div class="table-card">
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Empleado</th>
            <th>Cédula</th>
            <th>Teléfono</th>
            <th>Fecha Ingreso</th>
            <th class="data-table__th--right">Sueldo Base</th>
            <th class="data-table__th--right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @employees.each do |emp| %>
            <tr>
              <td>
                <span class="data-table__name"><%= emp.full_name_complete %></span>
              </td>
              <td class="data-table__td--code"><%= emp.cedula %></td>
              <td class="data-table__td--muted"><%= emp.telefono.presence || '-' %></td>
              <td class="data-table__td--muted">
                <%= emp.hire_date ? emp.hire_date.strftime("%d/%m/%Y") : '-' %>
              </td>
              <td class="data-table__td--right data-table__td--strong">
                $<%= number_with_precision(emp.salary || 0, precision: 2) %>
              </td>
              <td class="data-table__td--right">
                <%= link_to "Ver", employee_path(emp),
                      class: "action-link action-link--view" %>
                <%= link_to "Editar", edit_employee_path(emp),
                      class: "action-link action-link--edit" %>
                <%= link_to "Eliminar", employee_path(emp),
                      data: { turbo_method: :delete,
                              turbo_confirm: "¿Estás seguro de que deseas eliminar a #{emp.full_name_complete}?" },
                      class: "action-link action-link--delete" %>
              </td>
            </tr>
          <% end %>

          <% if @employees.none? %>
            <tr>
              <td colspan="6" class="data-table__empty">
                No hay empleados registrados en el sistema.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div style="text-align:center; margin:20px 0;">
    <%= link_to "Ver Inactivos", discarded_employees_path, class: "btn-primary" %>
  </div>

</div>
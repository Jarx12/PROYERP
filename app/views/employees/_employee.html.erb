<div id="<%= dom_id employee %>">
  <p>
    <strong>Name:</strong>
    <%= employee.name %>
  </p>

  <p>
    <strong>Surname:</strong>
    <%= employee.surname %>
  </p>

  <p>
    <strong>Name2:</strong>
    <%= employee.name2 %>
  </p>

  <p>
    <strong>Surname2:</strong>
    <%= employee.surname2 %>
  </p>

  <p>
    <strong>Cedula:</strong>
    <%= employee.cedula %>

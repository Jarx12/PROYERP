<% content_for :title, "Empleado: #{@employee.full_name}" %>

<div class="page">

  <header class="page__header">
    <%= link_to "← Volver a Empleados", employees_path, class: "page__back" %>
    <div class="page__actions">
      <%= link_to "📝 Editar Empleado", edit_employee_path(@employee), class: "btn btn--ghost" %>
    </div>
  </header>

  <!-- Hero: identidad + sueldo -->
  <div class="show-hero">
    <div class="show-hero__main">
      <div class="show-hero__tags">
        <span class="badge badge--muted">C.I. <%= @employee.cedula %></span>
      </div>

      <h1 class="show-hero__title"><%= @employee.full_name_complete %></h1>
    </div>

    <div class="show-stock">
      <span class="show-stock__label">Sueldo Base</span>
      <span class="show-stock__value">
        $<%= number_with_precision(@employee.salary || 0, precision: 2) %>
      </span>
    </div>
  </div>

  <!-- Grid de metadatos -->
  <div class="show-grid">

    <div class="show-card">
      <h2 class="show-card__title">📞 Datos de Contacto</h2>
      <div class="show-card__field">
        <span class="show-card__label">Teléfono:</span>
        <span class="show-card__value">
          <%= @employee.telefono.presence || "No registrado" %>
        </span>
      </div>
      <div class="show-card__field">
        <span class="show-card__label">Dirección:</span>
        <span class="show-card__value show-card__value--muted">
          <%= @employee.direccion.presence || "No registrada" %>
        </span>
      </div>
    </div>

    <div class="show-card">
      <h2 class="show-card__title">📅 Fechas Relevantes</h2>
      <div class="show-card__field">
        <span class="show-card__label">Fecha de Ingreso:</span>
        <span class="show-card__value">
          <%= @employee.hire_date ? @employee.hire_date.strftime("%d/%m/%Y") : "No registrada" %>
        </span>
      </div>
      <div class="show-card__field">
        <span class="show-card__label">Fecha de Nacimiento:</span>
        <span class="show-card__value show-card__value--muted">
          <%= @employee.birthday ? @employee.birthday.strftime("%d/%m/%Y") : "No registrada" %>
        </span>
      </div>
    </div>

  </div>

</div>
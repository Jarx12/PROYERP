<% content_for :title, "Editar Empleado: #{@employee.full_name}" %>

<div style="font-family: Arial, sans-serif; padding: 40px 20px; max-width: 850px; margin: 0 auto; line-height: 1.25;">

  <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
    <%= link_to "← Volver al expediente", employee_path(@employee), style: "color: #718096; text-decoration: none; font-size: 14px;" %>
    <%= link_to "Ver Expediente", employee_path(@employee), style: "padding: 8px 14px; border: 1px solid #cbd5e0; border-radius: 6px; color: #4a5568; text-decoration: none; font-size: 13px; font-weight: bold; background-color: white;" %>
  </div>

  <div style="background-color: white; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); padding: 30px;">
    
    <div style="border-bottom: 1px solid #edf2f7; padding-bottom: 15px; margin-bottom: 25px;">
      <h1 style="color: #1a202c; font-size: 24px; margin: 0; font-weight: bold;">📝 Editar Empleado</h1>
      <p style="color: #718096; font-size: 14px; margin: 5px 0 0 0;">Actualizando información de: <strong><%= @employee.full_name_complete %></strong></p>
    </div>

    <%= render "form", employee: @employee %>

  </div>

</div>
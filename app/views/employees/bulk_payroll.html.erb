<% content_for :page_styles do %>
  <%= stylesheet_link_tag "bulk_payroll", "data-turbo-track": "reload" %>
<% end %>

<% content_for :title, "Pago de Nómina en Masa" %>

<div class="page page--wide">

  <header class="page__header">
    <div>
      <h1 class="page__title">💳 Procesar Pago de Nómina en Masa</h1>
      <p class="page__subtitle">
        Ingresa referencias, comprobantes y ajustes extraordinarios por trabajador.
      </p>
    </div>
    <div class="page__actions">
      <%= link_to "Volver a Empleados", employees_path, class: "btn btn--ghost" %>
    </div>
  </header>

  <%= form_with(url: process_bulk_payroll_employees_path, multipart: true) do |f| %>

    <!-- CONFIGURACIÓN GENERAL -->
    <div class="form-card form-card--outlined" style="margin-bottom: 25px;">
      <div class="form-grid form-grid--4col">
        <div class="form-grid__span-2">
          <label class="form-label">Cuenta Bancaria de Origen <span class="form-label--required"></span></label>
          <%= select_tag :bank_account_id,
                options_from_collection_for_select(@bank_accounts, :id, :display_name),
                prompt: "Seleccione cuenta debitadora...",
                required: true,
                class: "form-select" %>
        </div>

        <div>
          <label class="form-label form-label--accent">Tasa de Cambio (Bs / USD) <span class="form-label--required"></span></label>
          <%= number_field_tag :exchange_rate, nil,
                step: "0.01",
                placeholder: "Ej. 36.50",
                id: "exchange_rate_input",
                required: true,
                class: "form-input" %>
        </div>

        <div>
          <label class="form-label">Fecha Período <span class="form-label--required"></span></label>
          <div class="form-row" style="margin-bottom: 0; gap: 10px;">
            <%= date_field_tag :period_start_date, Date.today,
                  required: true, class: "form-input" %>
            <%= date_field_tag :period_end_date, Date.today + 6,
                  required: true, class: "form-input" %>
          </div>
        </div>
      </div>
    </div>

    <!-- TABLA DE SELECCIÓN -->
    <div class="table-card" style="margin-bottom: 20px;">

      <div class="payroll-toolbar">
        <strong class="payroll-toolbar__title">Personal Seleccionado para Pago</strong>

        <div class="payroll-toolbar__actions">
          <span class="payroll-toolbar__label">Acciones Rápidas:</span>
          <button type="button" id="set_all_commission_zero" class="btn-mini">Todos 0%</button>
          <button type="button" id="set_all_commission_default" class="btn-mini btn-mini--info">Todos 0.3%</button>
          <span class="payroll-toolbar__divider">|</span>
          <button type="button" id="select_all_btn" class="btn-mini btn-mini--link primary">Marcar Todos</button>
          <button type="button" id="deselect_all_btn" class="btn-mini btn-mini--link danger">Desmarcar Todos</button>
          <button type="button" id="add_occasional_btn" class="btn-mini btn-mini--success">➕ Añadir</button>
        </div>
      </div>

      <div class="table-scroll">
        <table class="data-table data-table--inputs">
          <thead>
            <tr>
              <th class="data-table__cell--check">Incluir</th>
              <th class="data-table__cell--employee">Empleado</th>
              <th class="data-table__cell--commission">Comisión</th>
              <th class="data-table__cell--ref">N° Referencia</th>
              <th>Comprobante</th>
              <th class="data-table__cell--salary">Sueldo Base</th>
              <th class="data-table__cell--adjust">Ajuste ($)</th>
              <th class="data-table__cell--total">Total (Bs.)</th>
              <th class="data-table__cell--remove"></th>
            </tr>
          </thead>
          <tbody>
            <% @employees.each do |emp| %>
              <tr>
                <td class="data-table__cell--check">
                  <%= check_box_tag "employee_ids[]", emp.id, true, class: "employee_checkbox data-table__checkbox" %>
                </td>
                <td class="data-table__cell--employee">
                  <strong><%= emp.respond_to?(:full_name_complete) ? emp.full_name_complete : "#{emp.name} #{emp.surname}" %></strong>
                  <span class="data-table__meta">C.I: <%= emp.cedula %></span>
                </td>
                <td class="data-table__cell--commission">
                  <%= select_tag "commissions[#{emp.id}]",
                        options_for_select([["0% (Interno)", "0%"], ["0.3% (Otro Banco)", "0.3%"]], "0.3%"),
                        class: "employee_commission_select data-table__input" %>
                </td>
                <td class="data-table__cell--ref">
                  <%= text_field_tag "bank_references[#{emp.id}]", nil,
                        placeholder: "Ej. 000123",
                        class: "data-table__input data-table__input--code" %>
                </td>
                <td>
                  <%= file_field_tag "bank_receipts[#{emp.id}]",
                        accept: "image/*,application/pdf",
                        class: "data-table__file" %>
                </td>
                <td class="data-table__cell--salary">
                  $<span class="usd_salary" data-salary="<%= emp.salary || 0 %>">
                    <%= number_with_precision(emp.salary || 0, precision: 2) %>
                  </span>
                </td>
                <td class="data-table__cell--adjust">
                  <%= number_field_tag "adjustments[#{emp.id}]", nil,
                        step: "0.01", placeholder: "0.00",
                        class: "employee_adjustment_input data-table__input data-table__input--number data-table__input--accent" %>
                </td>
                <td class="data-table__cell--total">
                  <span class="bs_converted_amount">0.00</span> Bs.
                </td>
                <td class="data-table__cell--remove"></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- RESUMEN -->
    <div class="payroll-summary">
      <div>
        <span class="payroll-summary__label">Total Estimado a Procesar:</span>
        <strong id="grand_total_bs" class="payroll-summary__value">0.00 Bs.</strong>
      </div>
      <%= f.submit "🚀 Procesar Pago en Masa", class: "btn btn--dark btn--lg" %>
    </div>

  <% end %>
</div>

<script>
  (function () {
    let initialized = false;

    function initBulkPayroll() {
      if (initialized) return;
      initialized = true;

      const exchangeInput     = document.getElementById("exchange_rate_input");
      const checkboxes        = document.querySelectorAll(".employee_checkbox");
      const adjustmentInputs  = document.querySelectorAll(".employee_adjustment_input");
      const selectAllBtn      = document.getElementById("select_all_btn");
      const deselectAllBtn    = document.getElementById("deselect_all_btn");
      const setAllZeroBtn     = document.getElementById("set_all_commission_zero");
      const setAllDefaultBtn  = document.getElementById("set_all_commission_default");
      const grandTotalEl      = document.getElementById("grand_total_bs");
      const addOccasionalBtn  = document.getElementById("add_occasional_btn");

      function recalculate() {
        const rate = parseFloat(exchangeInput.value) || 0;
        let totalBs = 0;

        document.querySelectorAll("tbody tr").forEach(row => {
          const chk     = row.querySelector(".employee_checkbox");
          const bsSpan  = row.querySelector(".bs_converted_amount");
          const adjInput = row.querySelector(".employee_adjustment_input");
          const usdSpan = row.querySelector(".usd_salary");
          const extraUsdInput = row.querySelector(".extra_usd_salary");

          if (!bsSpan) return;

          let baseUsd = 0;
          if (usdSpan)        baseUsd = parseFloat(usdSpan.dataset.salary) || 0;
          if (extraUsdInput)  baseUsd = parseFloat(extraUsdInput.value) || 0;

          const extraAdj  = parseFloat(adjInput ? adjInput.value : 0) || 0;
          const finalUsd  = baseUsd + extraAdj;
          const bs        = finalUsd * rate;

          bsSpan.textContent = bs.toLocaleString("es-VE", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          });

          if (chk && chk.checked) totalBs += bs;
        });

        if (grandTotalEl) {
          grandTotalEl.textContent = totalBs.toLocaleString("es-VE", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }) + " Bs.";
        }
      }

      if (exchangeInput) exchangeInput.addEventListener("input", recalculate);
      checkboxes.forEach(chk => chk.addEventListener("change", recalculate));
      adjustmentInputs.forEach(adj => adj.addEventListener("input", recalculate));

      if (selectAllBtn)   selectAllBtn.addEventListener("click", () => {
        document.querySelectorAll(".employee_checkbox").forEach(c => c.checked = true);
        recalculate();
      });
      if (deselectAllBtn) deselectAllBtn.addEventListener("click", () => {
        document.querySelectorAll(".employee_checkbox").forEach(c => c.checked = false);
        recalculate();
      });
      if (setAllZeroBtn)    setAllZeroBtn.addEventListener("click", () => {
        document.querySelectorAll(".employee_commission_select").forEach(s => s.value = "0%");
      });
      if (setAllDefaultBtn) setAllDefaultBtn.addEventListener("click", () => {
        document.querySelectorAll(".employee_commission_select").forEach(s => s.value = "0.3%");
      });

      function addOccasionalWorker() {
        const tbody = document.querySelector("tbody");
        if (!tbody) return;

        const uid = Date.now() + Math.random();
        const tr  = document.createElement("tr");
        tr.className = "is-occasional";   // ← cambio clave: clase, no cssText

        tr.innerHTML = `
          <td class="data-table__cell--check">
            <input type="checkbox" checked class="employee_checkbox data-table__checkbox">
          </td>
          <td class="data-table__cell--employee">
            <input type="text" name="extra_workers[${uid}][name]" placeholder="Nombre completo" required class="data-table__input" style="margin-bottom:4px;">
            <input type="text" name="extra_workers[${uid}][cedula]" placeholder="C.I." required class="data-table__input">
          </td>
          <td class="data-table__cell--commission">
            <select name="extra_workers[${uid}][commission]" class="employee_commission_select data-table__input">
              <option value="0%">0% (Interno)</option>
              <option value="0.3%" selected>0.3% (Otro Banco)</option>
            </select>
          </td>
          <td class="data-table__cell--ref">
            <input type="text" name="extra_workers[${uid}][bank_reference]" placeholder="Ej. 000123" class="data-table__input data-table__input--code">
          </td>
          <td>
            <input type="file" name="extra_workers[${uid}][bank_receipt]" accept="image/*,application/pdf" class="data-table__file">
          </td>
          <td class="data-table__cell--salary">
            $<input type="number" name="extra_workers[${uid}][base_salary]" step="0.01" placeholder="0.00" class="extra_usd_salary data-table__input data-table__input--number">
          </td>
          <td class="data-table__cell--adjust">
            <input type="number" name="extra_workers[${uid}][adjustment]" step="0.01" placeholder="0.00" class="employee_adjustment_input data-table__input data-table__input--number data-table__input--accent">
          </td>
          <td class="data-table__cell--total">
            <span class="bs_converted_amount">0.00</span> Bs.
          </td>
          <td class="data-table__cell--remove">
            <button type="button" class="remove_extra_btn data-table__remove">✖</button>
          </td>
        `;
        tbody.appendChild(tr);

        const extraUsdInput = tr.querySelector(".extra_usd_salary");
        const adjInput      = tr.querySelector(".employee_adjustment_input");
        const checkbox      = tr.querySelector(".employee_checkbox");
        const removeBtn     = tr.querySelector(".remove_extra_btn");

        if (extraUsdInput) extraUsdInput.addEventListener("input", recalculate);
        if (adjInput)      adjInput.addEventListener("input", recalculate);
        if (checkbox)      checkbox.addEventListener("change", recalculate);
        if (removeBtn)     removeBtn.addEventListener("click", e => {
          e.stopPropagation();
          tr.remove();
          recalculate();
        });

        recalculate();
      }

      if (addOccasionalBtn) {
        const newBtn = addOccasionalBtn.cloneNode(true);
        addOccasionalBtn.parentNode.replaceChild(newBtn, addOccasionalBtn);

        newBtn.addEventListener("click", e => {
          e.preventDefault();
          addOccasionalWorker();
        });
      }

      recalculate();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initBulkPayroll);
    } else {
      initBulkPayroll();
    }

    document.addEventListener("turbo:load", () => {
      if (!initialized) initBulkPayroll();
    });
  })();
</script>
<%= form_with(model: employee) do |form| %>

  <% if employee.errors.any? %>
    <div class="form-alert form-alert--danger">
      <h2 class="form-alert__title">
        <%= pluralize(employee.errors.count, "error") %> impiden guardar los cambios:
      </h2>
      <ul class="form-alert__list">
        <% employee.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- ==================== Datos Personales ==================== -->
  <h2 class="form-section-title">Datos Personales</h2>

  <div class="form-row">
    <div class="form-col">
      <%= form.label :name, "Primer Nombre", class: "form-label form-label--required" %>
      <%= form.text_field :name, placeholder: "Ej. Juan", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :name2, "Segundo Nombre", class: "form-label" %>
      <%= form.text_field :name2, placeholder: "Ej. Carlos", class: "form-input" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-col">
      <%= form.label :surname, "Primer Apellido", class: "form-label form-label--required" %>
      <%= form.text_field :surname, placeholder: "Ej. Pérez", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :surname2, "Segundo Apellido", class: "form-label" %>
      <%= form.text_field :surname2, placeholder: "Ej. Rodríguez", class: "form-input" %>
    </div>
  </div>

  <div class="form-row">
    <div class="form-col">
      <%= form.label :cedula, "Cédula / Documento", class: "form-label form-label--required" %>
      <%= form.number_field :cedula, placeholder: "Ej. 12345678", class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :birthday, "Fecha de Nacimiento", class: "form-label" %>
      <%= form.date_field :birthday, class: "form-input" %>
    </div>
  </div>

  <!-- ==================== Contacto ==================== -->
  <h2 class="form-section-title form-section-title--spaced">📞 Contacto y Dirección</h2>

  <div class="form-row">
    <div class="form-col">
      <%= form.label :telefono, "Teléfono", class: "form-label" %>
      <%= form.text_field :telefono, placeholder: "Ej. 04121234567", class: "form-input" %>
    </div>
    <div class="form-col form-col--2">
      <%= form.label :direccion, "Dirección de Habitación", class: "form-label" %>
      <%= form.text_field :direccion, placeholder: "Ej. Av. Bolívar, Calle 4, Edif. Central", class: "form-input" %>
    </div>
  </div>

  <!-- ==================== Contratación ==================== -->
  <h2 class="form-section-title form-section-title--spaced">💼 Datos Contratación y Nómina</h2>

  <div class="form-row">
    <div class="form-col">
      <%= form.label :position_id, "Cargo / Puesto", class: "form-label" %>
      <%= form.collection_select :position_id,
            Position.order(:title), :id, :title,
            { include_blank: "-- Seleccionar Cargo --" },
            class: "form-select" %>
      <span class="form-hint">
        ¿No ves el cargo?
        <%= link_to "Gestionar Cargos", positions_path, target: "_blank" %>
      </span>
    </div>

    <div class="form-col">
      <%= form.label :hire_date, "Fecha de Ingreso", class: "form-label" %>
      <%= form.date_field :hire_date, class: "form-input" %>
    </div>

    <div class="form-col">
      <%= form.label :salary, "Sueldo Base ($)", class: "form-label form-label--accent" %>
      <%= form.number_field :salary, step: "0.01", min: 0,
            placeholder: "0.00", class: "form-input" %>
    </div>
  </div>

  <!-- ==================== Acciones ==================== -->
  <div class="form-actions">
    <%= link_to "Cancelar", employees_path, class: "btn btn--ghost" %>
    <%= form.submit "Guardar Empleado", class: "btn btn--success" %>
  </div>

<% end %>
<%= form_with(model: warehouse, local: true) do |form| %>

  <% if warehouse.errors.any? %>
    <div style="background-color: #fff5f5; border: 1px solid #fed7d7; color: #c53030; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
      <h2 style="font-size: 14px; margin: 0 0 5px 0; font-weight: bold;">
        <%= pluralize(warehouse.errors.count, "error") %> impiden guardar este almacén:
      </h2>
      <ul style="margin: 0; padding-left: 20px; font-size: 13px;">
        <% warehouse.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display: flex; gap: 15px; margin-bottom: 20px;">
    <div style="flex: 2;">
      <%= form.label :name, "Nombre del Almacén / Bodega *", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 6px; font-size: 13px;" %>
      <%= form.text_field :name, placeholder: "Ej. Depósito Central, Taller Principal...", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748;" %>
    </div>
    <div style="flex: 1;">
      <%= form.label :code, "Código Interno", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 6px; font-size: 13px;" %>
      <%= form.text_field :code, placeholder: "Ej. ALM-01", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748;" %>
    </div>
  </div>

  <div style="margin-bottom: 25px;">
    <%= form.label :address, "Dirección o Ubicación Física", style: "display: block; font-weight: bold; color: #4a5568; margin-bottom: 6px; font-size: 13px;" %>
    <%= form.text_field :address, placeholder: "Ej. Av. Principal, Edificio B, Zona Industrial", style: "width: 100%; padding: 10px 12px; border: 1px solid #cbd5e0; border-radius: 6px; box-sizing: border-box; font-size: 14px; color: #2d3748;" %>
  </div>

  <div style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e2e8f0; padding-top: 20px;">
    <%= link_to "Cancelar", settings_path, style: "padding: 10px 18px; border: 1px solid #cbd5e0; border-radius: 6px; color: #4a5568; text-decoration: none; font-size: 14px; font-weight: bold; background-color: white;" %>
    <%= form.submit "Guardar Almacén", style: "padding: 10px 20px; border: none; border-radius: 6px; color: white; background-color: #3182ce; font-size: 14px; font-weight: bold; cursor: pointer;" %>
  </div>

<% end %>
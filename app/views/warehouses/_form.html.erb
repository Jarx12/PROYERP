<%= form_with(model: warehouse) do |form| %>

  <% if warehouse.errors.any? %>
    <div class="form-alert form-alert--danger">
      <h2 class="form-alert__title">
        <%= pluralize(warehouse.errors.count, "error") %> impiden guardar este almacén:
      </h2>
      <ul class="form-alert__list">
        <% warehouse.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Nombre + Código -->
  <div class="form-row">
    <div class="form-col form-col--2">
      <%= form.label :name, "Nombre del Almacén / Bodega",
            class: "form-label form-label--required" %>
      <%= form.text_field :name,
            placeholder: "Ej. Depósito Central, Taller Principal...",
            class: "form-input" %>
    </div>
    <div class="form-col">
      <%= form.label :code, "Código Interno", class: "form-label" %>
      <%= form.text_field :code,
            placeholder: "Ej. ALM-01",
            class: "form-input" %>
    </div>
  </div>

  <!-- Dirección -->
  <div class="form-row form-row--last">
    <div class="form-col">
      <%= form.label :address, "Dirección o Ubicación Física", class: "form-label" %>
      <%= form.text_field :address,
            placeholder: "Ej. Av. Principal, Edificio B, Zona Industrial",
            class: "form-input" %>
    </div>
  </div>

  <!-- Acciones -->
  <div class="form-actions">
    <%= link_to "Cancelar", settings_path, class: "btn btn--ghost" %>
    <%= form.submit "Guardar Almacén", class: "btn btn--primary" %>
  </div>

<% end %>
<div style="font-family: Arial, sans-serif; padding: 40px 20px; max-width: 600px; margin: 0 auto;">
  <h1 style="color: #1a202c; font-size: 24px; margin-bottom: 20px;">✏️ Editar Categoría Financiera</h1>
  
  <%= form_with(model: @transaction_category, local: true) do |form| %>
    <div style="margin-bottom: 15px;">
      <%= form.label :name, "Nombre de la Categoría*", style: "display: block; font-weight: 500; margin-bottom: 5px;" %>
      <%= form.text_field :name, placeholder: "Ej. Ventas, Nómina, Servicios Públicos", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>

    <div style="margin-bottom: 25px;">
      <%= form.label :description, "Descripción (Opcional)", style: "display: block; font-weight: 500; margin-bottom: 5px;" %>
      <%= form.text_area :description, rows: 3, style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 10px;">
      <%= link_to "Cancelar", settings_path, style: "padding: 10px 20px; background: #e5e7eb; color: #374151; text-decoration: none; border-radius: 6px;" %>
      <%= form.submit "Guardar Categoría", style: "padding: 10px 20px; background: #dd6b20; color: white; border: none; border-radius: 6px; cursor: pointer;" %>
    </div>
  <% end %>
</div>
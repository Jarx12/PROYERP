<%= form_with(model: transaction_category) do |form| %>

  <% if transaction_category.errors.any? %>
    <div class="form-alert form-alert--danger">
      <h2 class="form-alert__title">
        <%= pluralize(transaction_category.errors.count, "error") %> impiden guardar esta categoría:
      </h2>
      <ul class="form-alert__list">
        <% transaction_category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Nombre -->
  <div class="form-row">
    <div class="form-col">
      <%= form.label :name, "Nombre de la Categoría",
            class: "form-label form-label--required" %>
      <%= form.text_field :name,
            placeholder: "Ej. Pago de Nómina, Venta de Productos, Servicios",
            class: "form-input" %>
    </div>
  </div>

  <!-- Descripción -->
  <div class="form-row form-row--last">
    <div class="form-col">
      <%= form.label :description, "Descripción (Opcional)", class: "form-label" %>
      <%= form.text_area :description, rows: 3,
            class: "form-input form-textarea" %>
    </div>
  </div>

  <!-- Acciones -->
  <div class="form-actions">
    <%= link_to "Cancelar", settings_path, class: "btn btn--ghost" %>
    <%= form.submit "Guardar Categoría", class: "btn btn--warning" %>
  </div>

<% end %>
<% content_for :title, "Soluciones - ProyERP" %>

<section class="pub-hero">
  <div class="pub-hero__inner">
    <span class="hero__badge">Soluciones</span>
    <h1 class="pub-hero__title">Conectividad confiable para su operación</h1>
    <p class="pub-hero__text">
      Diseñamos, implementamos y soportamos infraestructura de telecomunicaciones
      para que su empresa mantenga la continuidad operativa.
    </p>
  </div>
</section>

<section class="pub-section">
  <div class="pub-section__inner">
    <h2 class="pub-section__title">Servicios que resolvemos</h2>
    <p class="pub-section__text">
      Unimos obra civil, conectividad y soporte técnico para construir soluciones
      adaptadas a la realidad operativa de cada organización.
    </p>

    <div class="modules__grid">
      <article class="module-card">
        <div class="module-card__icon module-card__icon--blue">◈</div>
        <h3 class="module-card__title">Fibra Óptica</h3>
        <p class="module-card__text">
          Enlaces dedicados de alta capacidad para la transmisión de datos
          crítica entre sedes interurbanas.
        </p>
        <p class="module-card__text">
          Diseño, instalación y puesta en marcha de fibra enterrada, aérea,
          ADSS y obras civiles.
        </p>
      </article>

      <article class="module-card">
        <div class="module-card__icon module-card__icon--orange">◌</div>
        <h3 class="module-card__title">Radioenlaces</h3>
        <p class="module-card__text">
          Conectividad inalámbrica de alta velocidad para zonas remotas y
          puntos de difícil acceso.
        </p>
        <p class="module-card__text">
          Enlaces punto a punto y multipunto organizados para ampliar la
          cobertura y ofrecer respaldo de última milla.
        </p>
      </article>

      <article class="module-card">
        <div class="module-card__icon module-card__icon--teal">☎</div>
        <h3 class="module-card__title">Telefonía Corporativa</h3>
        <p class="module-card__text">
          Sistemas de voz IP y troncales SIP para integrar la comunicación
          dentro de su organización.
        </p>
        <p class="module-card__text">
          Soluciones con capacidad de crecimiento, integración y soporte.
        </p>
      </article>

      <article class="module-card">
        <div class="module-card__icon module-card__icon--gray">↔</div>
        <h3 class="module-card__title">Redes Empresariales</h3>
        <p class="module-card__text">
          Diseño, implementación y monitoreo de cableado estructurado,
          puntos de acceso y redes internas tolerantes a fallas.
        </p>
        <p class="module-card__text">
          Implementación de redes tolerantes a fallas y soporte continuo.
        </p>
      </article>
    </div>
  </div>
</section>

<section class="pub-section pub-section--alt">
  <div class="pub-section__inner">
    <h2 class="pub-section__title">Un enfoque integral</h2>
    <p class="pub-section__text">
      Acompañamos cada proyecto desde la evaluación inicial hasta la
      operación diaria, con responsables técnicos disponibles para resolver
      incidentes y optimizar el servicio.
    </p>

    <div class="about__stats">
      <div class="about__stat">
        <p class="about__stat-value">01</p>
        <p class="about__stat-label">Diagnóstico técnico y diseño de la solución</p>
      </div>
      <div class="about__stat">
        <p class="about__stat-value">02</p>
        <p class="about__stat-label">Implementación y puesta en operación</p>
      </div>
      <div class="about__stat">
        <p class="about__stat-value">03</p>
        <p class="about__stat-label">Monitoreo, soporte y mantenimiento continuo</p>
      </div>
    </div>

    <div class="pub-section__actions">
      <%= link_to "Solicitar una cotización", contactanos_path,
            class: "btn btn--primary btn--lg" %>
    </div>
  </div>
</section>

<% content_for :title, "Proyectos - ProyERP" %>

<!-- Hero público -->
<section class="pub-hero">
  <div class="pub-hero__inner">
    <span class="hero__badge">Portafolio</span>
    <h1 class="pub-hero__title">Nuestros Proyectos</h1>
    <p class="pub-hero__text">
      Una selección de implementaciones de infraestructura de
      telecomunicaciones realizadas para empresas líderes del oriente del país.
    </p>
  </div>
</section>

<!-- Grid de proyectos (dinámico) -->
<section class="pub-section">
  <div class="pub-section__inner">

    <% if @proyectos.any? %>
      <div class="projects-grid">
        <% @proyectos.each do |proyecto| %>
          <article class="project-card">
            <% if proyecto.cover_image.attached? %>
              <div class="project-card__media">
                <%= image_tag rails_blob_path(proyecto.cover_image),
                      alt: proyecto.name %>
              </div>
            <% end %>

            <div class="project-card__body">
              <h3 class="project-card__title">
                <%= proyecto.name.presence || "Proyecto" %>
              </h3>

              <dl class="project-card__details">
                <div class="project-card__detail">
                  <dt>Cliente</dt>
                  <dd><%= proyecto.customer.presence || "No especificado" %></dd>
                </div>
                <div class="project-card__detail">
                  <dt>Ubicación</dt>
                  <dd><%= proyecto.location.presence || "No especificada" %></dd>
                </div>
                <div class="project-card__detail">
                  <dt>Inicio</dt>
                  <dd>
                    <% if proyecto.start_date %>
                      <time datetime="<%= proyecto.start_date.iso8601 %>">
                        <%= proyecto.start_date.strftime("%d/%m/%Y") %>
                      </time>
                    <% else %>
                      No especificada
                    <% end %>
                  </dd>
                </div>
                <div class="project-card__detail">
                  <dt>Fin</dt>
                  <dd>
                    <% if proyecto.end_date %>
                      <time datetime="<%= proyecto.end_date.iso8601 %>">
                        <%= proyecto.end_date.strftime("%d/%m/%Y") %>
                      </time>
                    <% else %>
                      No especificada
                    <% end %>
                  </dd>
                </div>
              </dl>

              <p class="project-card__desc">
                <%= truncate(proyecto.description.presence || "Sin descripción disponible.", length: 140) %>
              </p>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <!-- Estado vacío: cuando aún no hay proyectos registrados -->
      <div class="data-table__empty" style="padding: 60px 20px;">
        <p style="font-size: 18px; margin-bottom: 10px;">
          🚧 Pronto estaremos publicando nuestros proyectos destacados.
        </p>
        <p style="font-size: 14px; color: var(--color-text-muted);">
          Mientras tanto, puedes
          <%= link_to "contactarnos", contactanos_path, class: "link-inline" %>
          para conocer más sobre nuestro trabajo.
        </p>
      </div>
    <% end %>

  </div>
</section>

<!-- CTA final -->
<section class="pub-section pub-section--alt">
  <div class="pub-section__inner" style="text-align: center;">
    <h2 class="pub-section__title">¿Tienes un proyecto en mente?</h2>
    <p class="pub-section__text" style="max-width: 600px; margin: 0 auto 25px;">
      Conversemos sobre cómo podemos ayudarte a garantizar la continuidad
      operativa de tu empresa.
    </p>
    <%= link_to "Contáctanos", contactanos_path, class: "btn btn--primary btn--lg" %>
  </div>
</section>
<div style="font-family: Arial, sans-serif; padding: 40px 20px; max-width: 800px; margin: 0 auto;">
  <header style="margin-bottom: 30px; border-bottom: 2px solid #e2e8f0; padding-bottom: 15px;">
    <h1 style="color: #1a202c; font-size: 24px; margin: 0;">➕ Registrar Transacción</h1>
    <p style="color: #718096; margin: 5px 0 0 0; font-size: 14px;">Ingreso o egreso asociado a una cuenta bancaria.</p>
  </header>

  <div style="background-color: white; border: 1px solid #e2e8f0; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); padding: 30px;">
    <%= render "form", financial_transaction: @financial_transaction %>
  </div>
</div>
<%= form_with(model: financial_transaction, local: true) do |form| %>
  <% if financial_transaction.errors.any? %>
    <div style="background-color: #fee2e2; color: #991b1b; padding: 12px; border-radius: 6px; margin-bottom: 20px; font-size: 14px;">
      <p style="font-weight: bold; margin-bottom: 5px;">Por favor corrige los siguientes errores:</p>
      <ul style="margin: 0; padding-left: 20px;">
        <% financial_transaction.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
    <div>
      <%= form.label :transaction_type, "Tipo de Transacción*", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
      <%= form.select :transaction_type, [["📥 Ingreso", "income"], ["📤 Egreso", "expense"]], { prompt: "Seleccione tipo" }, id: "transaction_type_select", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>
    <div>
      <%= form.label :bank_account_id, "Cuenta Bancaria*", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
      <%= form.collection_select :bank_account_id, BankAccount.all, :id, :display_name, { prompt: "Seleccione cuenta" }, style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
    <div>
      <%= form.label :amount, "Monto*", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
      <%= form.number_field :amount, step: "0.01", placeholder: "0.00", id: "transaction_amount_input", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>
    <div>
      <%= form.label :bank_reference, "N° de Referencia Bancaria", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
      <%= form.text_field :bank_reference, placeholder: "Ej: 0000123489", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>
  </div>

  <div style="margin-bottom: 15px;">
    <%= form.label :transaction_date, "Fecha*", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
    <%= form.date_field :transaction_date, style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
  </div>

  <!-- BLOQUE INTELIGENTE CON BOTONES Y CALCULADORA EN VIVO -->
  <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 15px; margin-bottom: 15px;">
    <%= form.label :commission_percentage, "🏦 Comisión Bancaria (%)", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
    
    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 8px;">
      <%= form.text_field :commission_percentage, placeholder: "Ej. 0.3%, 3% o 4.1%", id: "commission_percentage_input", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>

    <!-- Botones de selección rápida -->
    <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px;">
      <span style="font-size: 12px; color: #6b7280; font-weight: 500;">Sugerencias:</span>
      <button type="button" class="quick-percent-btn" data-value="0%" style="padding: 3px 8px; font-size: 12px; background: #e2e8f0; border: none; border-radius: 4px; cursor: pointer;">0%</button>
      <button type="button" class="quick-percent-btn" data-value="0.3%" style="padding: 3px 8px; font-size: 12px; background: #e2e8f0; border: none; border-radius: 4px; cursor: pointer;">0.3%</button>
      <button type="button" class="quick-percent-btn" data-value="3%" style="padding: 3px 8px; font-size: 12px; background: #e2e8f0; border: none; border-radius: 4px; cursor: pointer;">3%</button>
      <button type="button" class="quick-percent-btn" data-value="4.1%" style="padding: 3px 8px; font-size: 12px; background: #e2e8f0; border: none; border-radius: 4px; cursor: pointer;">4.1%</button>
    </div>

    <!-- Vista previa de la comisión en tiempo real -->
    <div id="commission_preview" style="font-size: 13px; font-weight: 600; color: #2563eb; display: none;">
      💡 Comisión a generar: <span id="commission_preview_amount">0.00</span> Bs.
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
    <div>
      <%= form.label :transaction_category_id, "Categoría de Gasto/Ingreso", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
      <%= form.collection_select :transaction_category_id, TransactionCategory.all, :id, :name, { prompt: "Ninguna / General" }, style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>
    <div>
      <%= form.label :beneficiary, "Beneficiario (Opcional)", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
      <%= form.text_field :beneficiary, placeholder: "Ej. Proveedor C.A.", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
    <div>
      <%= form.label :employee_id, "Trabajador Responsable (Opcional)", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
      <%= form.collection_select :employee_id, Employee.all, :id, ->(e) { "#{e.name} #{e.surname}" }, { prompt: "Seleccionar de la nómina..." }, style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>
    <div>
      <%= form.label :responsible_name, "O Responsable Libre (Texto)", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
      <%= form.text_field :responsible_name, placeholder: "Ej. Juan Pérez (Externo)", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
    </div>
  </div>

  <div style="margin-bottom: 15px;">
    <%= form.label :description, "Descripción detallada*", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
    <%= form.text_area :description, rows: 3, placeholder: "Detalle del movimiento...", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px;" %>
  </div>

  <div style="margin-bottom: 15px;">
    <%= form.label :invoice_file, "📄 Documento Asociado / Factura (PDF o Imagen)", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
    <%= form.file_field :invoice_file, accept: "image/*,application/pdf", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; background: #f9fafb;" %>
  </div>

  <div style="margin-bottom: 25px;">
    <%= form.label :bank_receipt, "🏦 Comprobante de Transacción Bancaria", style: "display: block; font-weight: 500; margin-bottom: 5px; color: #374151;" %>
    <%= form.file_field :bank_receipt, accept: "image/*,application/pdf", style: "width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 6px; background: #f9fafb;" %>
  </div>

  <div style="display: flex; justify-content: flex-end; gap: 10px;">
    <%= link_to "Cancelar", financial_transactions_path, style: "padding: 10px 20px; background: #e5e7eb; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;" %>
    <%= form.submit "Guardar Transacción", style: "padding: 10px 20px; background: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;" %>
  </div>
<% end %>

<script>
  (function() {
    function setupCommissionLogic() {
      const typeSelect = document.getElementById("transaction_type_select");
      const commissionInput = document.getElementById("commission_percentage_input");
      const amountInput = document.getElementById("transaction_amount_input");
      const previewDiv = document.getElementById("commission_preview");
      const previewAmount = document.getElementById("commission_preview_amount");
      const quickBtns = document.querySelectorAll(".quick-percent-btn");

      if (!typeSelect || !commissionInput) return;

      // 1. Establece valor sugerido por defecto según el tipo de transacción
      function applyDefaultPercentage() {
        if (commissionInput.value.trim() !== "") return; // No sobrescribir si el usuario ya escribió algo

        if (typeSelect.value === "expense") {
          commissionInput.value = "0.3%";
        } else if (typeSelect.value === "income") {
          commissionInput.value = "0%";
        }
        updatePreview();
      }

      // 2. Proyección visual del monto final de la comisión
      function updatePreview() {
        if (!amountInput || !previewDiv || !previewAmount) return;

        const rawPercent = commissionInput.value.replace('%', '').replace(',', '.').trim();
        const percent = parseFloat(rawPercent) || 0;
        const amount = parseFloat(amountInput.value) || 0;

        if (percent > 0 && amount > 0) {
          const calculated = amount * (percent / 100.0);
          const finalCommission = Math.max(calculated, 14.0).toFixed(2);
          
          previewAmount.textContent = finalCommission;
          previewDiv.style.display = "block";
        } else {
          previewDiv.style.display = "none";
        }
      }

      // Escuchadores de eventos
      typeSelect.addEventListener("change", function() {
        if (typeSelect.value === "expense") {
          commissionInput.value = "0.3%";
        } else if (typeSelect.value === "income") {
          commissionInput.value = "0%";
        }
        updatePreview();
      });

      commissionInput.addEventListener("input", updatePreview);
      if (amountInput) amountInput.addEventListener("input", updatePreview);

      quickBtns.forEach(btn => {
        btn.addEventListener("click", function() {
          commissionInput.value = this.dataset.value;
          updatePreview();
        });
      });

      // Ejecutar evaluación inicial al cargar
      applyDefaultPercentage();
      updatePreview();
    }

    // Inicialización compatible con Turbo y carga standard
    document.addEventListener("DOMContentLoaded", setupCommissionLogic);
    document.addEventListener("turbo:load", setupCommissionLogic);
  })();
</script>
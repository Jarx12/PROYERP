<% content_for :title, "Finanzas - ProyERP" %>

<% selected_account = @bank_accounts.find_by(id: params[:bank_account_id]) %>

<div class="page page--wide">

  <header class="page__header page__header--bordered">
    <div>
      <h1 class="page__title">📊 Historial de Transacciones</h1>
      <p class="page__subtitle">Registro completo de ingresos y egresos bancarios.</p>
    </div>
    <div class="page__actions">
      <% if can?("finance", :write) %>
        <%= link_to "⬇️ Importar masivamente", bulk_import_financial_transactions_path,
              class: "btn btn--teal" %>
        <%= link_to "+ Nueva Transacción", new_financial_transaction_path,
              class: "btn btn--primary" %>
      <% end %>
    </div>
  </header>

  <!-- Filtro por cuenta -->
  <div class="filter-bar">
    <%= form_with url: financial_transactions_path, method: :get, local: true,
          class: "filter-bar__form" do |f| %>
      <%= f.label :bank_account_id, "🏦 Filtrar por Cuenta", class: "filter-bar__label" %>

      <%= f.select :bank_account_id,
            options_from_collection_for_select(
              @bank_accounts, :id, ->(account) { "#{account.institution} (#{account.currency})" },
              params[:bank_account_id]
            ),
            { include_blank: "-- Todas las Cuentas --" },
            { onchange: "this.form.submit();", class: "filter-bar__select" } %>

      <% if params[:bank_account_id].present? %>
        <%= link_to "Limpiar filtro", financial_transactions_path, class: "link-inline" %>
      <% end %>
    <% end %>

    <% if selected_account %>
      <div class="filter-bar__balance">
        Saldo actual:
        <strong>
          <%= selected_account.currency == "USD" ? "$" : "Bs." %>
          <%= number_to_currency(selected_account.balance, unit: "", delimiter: ".", separator: ",") %>
        </strong>
      </div>
    <% end %>
  </div>


  <!-- Tabla de Resultados -->
  <div class="table-card">
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Tipo</th>
            <th>Cuenta Bancaria</th>
            <th>Ref. Bancaria</th>
            <th>Descripción</th>
            <th>Beneficiario</th>
            <th>Responsable</th>
            <th class="data-table__th--right">Monto</th>
            <th class="data-table__th--center">Adjuntos</th>
            <th class="data-table__th--right">Acciones</th>
          </tr>
        </thead>
        <tbody>
        <% if @financial_transactions.any? %>
          <% @financial_transactions.each do |tx| %>
            <% invoice_attachment = tx.try(:invoice) || tx.try(:invoice_file) %>
            <% receipt_attachment = tx.respond_to?(:bank_receipt) ? tx.bank_receipt : nil %>

            <tr>
              <!-- 1. Fecha -->
              <td class="data-table__td--code"><%= tx.transaction_date.strftime("%d/%m/%Y") %></td>

              <!-- 2. Tipo -->
              <td>
                <% if tx.transaction_type == "income" %>
                  <span class="badge badge--success">📥 Ingreso</span>
                <% else %>
                  <span class="badge badge--danger">📤 Egreso</span>
                <% end %>
              </td>

              <!-- 3. Cuenta Bancaria -->
              <td>
                <span class="data-table__name"><%= tx.bank_account.institution %></span>
                <span class="data-table__meta"><%= tx.bank_account.currency %></span>
              </td>

              <!-- 4. Referencia Bancaria -->
              <td class="data-table__td--code"><%= tx.bank_reference.presence || "N/A" %></td>

              <!-- 5. Descripción -->
              <td><%= truncate(tx.description.to_s, length: 40) %></td>

              <!-- 6. Beneficiario -->
              <td><%= tx.beneficiary.presence || "—" %></td>

              <!-- 7. Responsable -->
              <td class="data-table__td--muted"><%= tx.responsible_name.presence || "—" %></td>

              <!-- 8. Monto -->
              <td class="data-table__td--right <%= tx.transaction_type == "income" ? "text-success" : "text-danger" %>">
                <%= tx.bank_account.currency == "USD" ? "$" : "Bs." %>
                <%= number_to_currency(tx.amount, unit: "", delimiter: ".", separator: ",") %>
              </td>

            <!-- 9. Adjuntos (Factura + Comprobante Bancario) -->
              <td class="data-table__td--center">
                <div class="attachments">
                  <% if invoice_attachment&.attached? %>
                    <%= link_to rails_blob_path(invoice_attachment, disposition: "inline"),
                          target: "_blank",
                          title: "Factura",
                          class: "attachment-link" do %>
                      📄
                    <% end %>
                  <% end %>

                  <% if receipt_attachment&.attached? %>
                    <%= link_to rails_blob_path(receipt_attachment, disposition: "inline"),
                          target: "_blank",
                          title: "Comprobante bancario",
                          class: "attachment-link" do %>
                      🏦
                    <% end %>
                  <% end %>

                  <% unless invoice_attachment&.attached? || receipt_attachment&.attached? %>
                    <span class="attachments__empty">Sin adjuntos</span>
                  <% end %>
                </div>
              </td>

              <!-- 10. Acciones -->
              <td class="data-table__td--right">
                <div class="data-table__actions">
                  <%= button_to "Eliminar", financial_transaction_path(tx),
                        method: :delete,
                        data: { turbo_confirm: "¿Estás seguro de eliminar esta transacción? Se revertirá el saldo de la cuenta." },
                        class: "btn btn--sm btn--danger" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="10" class="data-table__empty">
              📊 No hay transacciones registradas en el sistema.
            </td>
          </tr>
        <% end %>
      </tbody>
      </table>
    </div>
  </div>

  <!-- Controles de Paginación -->
  <div class="page__pagination">
    <%= paginate @financial_transactions %>
  </div>
</div>
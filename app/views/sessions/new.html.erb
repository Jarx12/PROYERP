<% content_for :title, "Acceso - ProyERP" %>

<div class="auth-wrapper">
  <div class="auth-card">
    <h1 class="auth-card__title">Acceso a ProyERP</h1>

    <%# Errores globales (opcional) %>
    <% if flash[:alert] %>
      <div class="form-alert form-alert--danger">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: login_path do |f| %>
      <div class="form-group">
        <%= f.label :identifier, "Usuario o Correo Electrónico", class: "form-label" %>
        <%= f.text_field :identifier, required: true, autofocus: true, class: "form-input" %>
        <span class="form-hint">Puede iniciar sesión con su nombre de usuario o con su correo.</span>
      </div>

      <div class="form-group form-group--last">
        <%= f.label :password, "Contraseña", class: "form-label" %>
        <%= f.password_field :password, required: true, class: "form-input" %>
      </div>

      <%= f.submit "Iniciar Sesión", class: "form-submit" %>
    <% end %>
  </div>
</div>